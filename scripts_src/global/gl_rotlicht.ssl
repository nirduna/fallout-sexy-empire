/*
   gl_rotlicht.ssl - Globales Skript fuer "Rotlicht ueber dem Oedland"

   Aufgaben (Phase 5):
     1. Wochenabrechnung aller eigenen Haeuser, auch nachtraeglich fuer
        Wochen, in denen der Spieler unterwegs war (hoechstens 12).
     2. Stadt-Modifikatoren aus dem Zustand der Vanilla-Welt ableiten.
     3. Laeufer bringen das Geld ins Hauptquartier (Strumpfband).
     4. Ereigniswurf pro Haus: kleine Ereignisse loest die Madame,
        der Rest wird zur Krise, die der Spieler vor Ort loesen muss.
     5. Stadtruf, Titel und Endslides nachfuehren (Phase 6).
     6. Selbsttest gegen tools/economy_sim.py (mit -mRL_SELBSTTEST).
     7. Die Kellertreppe zur Gosse auf Den Business 2 setzen (Umsetzung 2).
     8. Personalwechsel: Anwerbung und Abgaenge (Umsetzung 3, Phase 4).
     9. Questline "Ketten", Akt 2-5: Akte, Auftraege, Durchsuchung, Vergeltung,
        Enden und Mara als Madame (Umsetzung 5, rl_ketten.h).
    10. New Reno (Umsetzung 7, rl_newreno.h): Bishops Brief bei Westin abgeben,
        die aufgeflogene Faelschung, Familientreffen, Shark Club, Jet-Vertrag,
        misstrauische Familien.
    11. Redding (Umsetzung 8, rl_redding.h): gezinkte Waage und Revolte,
        Malamute Saloon, Marion als Schutzherr nach der Wanamingo-Mine.

   sfall laedt alle gl*.int beim Spielstart. Die Wochenlogik laeuft nur
   auf lokalen Karten; Reisezeit auf der Weltkarte wird beim naechsten
   Tick nachgerechnet.
*/

#define SCRIPT_REALNAME "gl_rotlicht"
#include "define.h"
#include "command.h"
#include "den.h"
#include "../headers/rotlicht.h"

// Aus newreno.h (der Header setzt ein Dialog-Skript mit NAME voraus):
// big_jesus_dead = get_new_reno_flag(big_jesus_dead_bit, 2)
#define rl_big_jesus_dead           gvar_bit(GVAR_NEW_RENO_FLAG_2, bit_26)

#define RL_TICK_FRAMES              (600)   // etwa alle 10 Sekunden pruefen
#define RL_TEXTDATEI                "rotlicht.msg"   // text/<sprache>/game/, per sfall geladen
#define RL_TASTE_SPAWN              (67)    // DIK_F9: Debug, Essie und Kolbe erscheinen lassen
#define RL_TASTE_GOSSE              (87)    // DIK_F11: Debug, direkt in die Gosse (RLDEN01)
#define RL_TASTE_TREPPE             (66)    // DIK_F8: Debug, auf Den Business 2 neben die Kellertreppe
// Nicht F10: Das ist im Spiel "Beenden". F1-F7 und F12 sind ebenfalls belegt.

procedure start;
procedure map_enter_p_proc;
procedure rl_tick;
procedure rl_gosse_eingang;
procedure rl_eingaenge;
procedure rl_personalwechsel(variable h);
procedure rl_welt_modifikatoren;
procedure rl_laeufer;
procedure rl_ereignis_wurf(variable h);
procedure rl_ereignis_waehlen(variable h);
procedure rl_haus_name(variable h);
procedure rl_stadtruf(variable h, variable woche);
procedure rl_ende_und_titel;
procedure rl_setze_gvar(variable gvar, variable wert);
procedure rl_selbsttest;
procedure rl_prolog_nachlauf;
procedure rl_text(variable n);
procedure rl_ketten_woche(variable woche);
procedure rl_ketten_tick;
procedure rl_auftrag_abschluss;
procedure rl_nr_woche(variable woche);
procedure rl_nr_brief;
procedure rl_red_woche(variable woche);
#ifdef RL_DEBUG
procedure rl_taste;
procedure rl_debug_spawn;
#endif

variable haus;
variable welt;
variable rl_texte := -1;    // Datei-ID von rotlicht.msg

procedure start begin
   if (game_loaded) then begin
      set_global_script_repeat(RL_TICK_FRAMES);
      rl_texte := add_extra_msg_file(RL_TEXTDATEI);   // sfall vergisst die ID beim Laden
      haus := rl_lade_haeuser;
      welt := rl_lade_welt;
#ifdef RL_DEBUG
      register_hook_proc(HOOK_KEYPRESS, rl_taste);
#endif
#ifdef RL_SELBSTTEST
      call rl_selbsttest;
#endif
   end else begin
      call rl_tick;
   end
end

// sfall ruft map_enter_p_proc globaler Skripte bei jedem Kartenwechsel auf
procedure map_enter_p_proc begin
   if (cur_map_index == MAP_DEN_BUSINESS) then call rl_gosse_eingang;
   call rl_eingaenge;
   if (cur_map_index == MAP_NCR_WESTIN_RANCH) then call rl_nr_brief;
end

/* Die Gosse: Die Vanilla-Karte Den Business 2 bleibt unveraendert. Die
   Kellertreppe wird gesetzt, sobald sie fehlt (auch nach dem Laden eines
   Spielstands, in dem sie noch nicht existierte; dafuer ruft auch der Tick
   diese Prozedur). Liegt sie nach einem Update an einem anderen Hex
   (RL_GOSSE_TREPPE_HEX geaendert), wird die alte entfernt. */
procedure rl_gosse_eingang begin
   variable alt, obj;
   if (welt == 0) then welt := rl_lade_welt;
   alt := welt[RL_W_GOSSE_TREPPE] - 1;
   if ((alt >= 0) and (alt != RL_GOSSE_TREPPE_HEX)) then begin
      obj := tile_contains_pid_obj(alt, RL_GOSSE_TREPPE_EBENE, RL_GOSSE_TREPPE_PID);
      if (obj) then destroy_object(obj);
   end
   if (tile_contains_pid_obj(RL_GOSSE_TREPPE_HEX, RL_GOSSE_TREPPE_EBENE, RL_GOSSE_TREPPE_PID) == 0) then
      obj := create_object_sid(RL_GOSSE_TREPPE_PID, RL_GOSSE_TREPPE_HEX, RL_GOSSE_TREPPE_EBENE, SCRIPT_RLGOSSE);
   welt[RL_W_GOSSE_TREPPE] := RL_GOSSE_TREPPE_HEX + 1;
end

/* Die weiteren Haeuser (Umsetzung 6): je Stadt eine Treppe auf der Vanilla-
   Stadtkarte, gesetzt wie die Kellertreppe der Gosse. */
procedure rl_eingaenge begin
   variable h, alt, obj, hexfeld;
   h := rl_haus_von_stadtkarte(cur_map_index);
   if (h <= 0) then return;
   if (welt == 0) then welt := rl_lade_welt;
   hexfeld := rl_eingang_hex(h);
   alt := welt[RL_W_EINGANG + h] - 1;
   if ((alt >= 0) and (alt != hexfeld)) then begin
      obj := tile_contains_pid_obj(alt, 0, RL_GOSSE_TREPPE_PID);
      if (obj) then destroy_object(obj);
   end
   if (tile_contains_pid_obj(hexfeld, 0, RL_GOSSE_TREPPE_PID) == 0) then
      obj := create_object_sid(RL_GOSSE_TREPPE_PID, hexfeld, 0, SCRIPT_RLTUER);
   welt[RL_W_EINGANG + h] := hexfeld + 1;
end

procedure rl_tick begin
   variable jetzt, wochen, h, tyrann, ausbeutung;

   if (cur_map_index == MAP_DEN_BUSINESS) then call rl_gosse_eingang;
   call rl_eingaenge;
   call rl_prolog_nachlauf;
   if (welt[RL_W_AKTIV] == 0) then return;
   call rl_ketten_tick;

   jetzt  := game_time_in_seconds / RL_SEKUNDEN_WOCHE;
   wochen := jetzt - welt[RL_W_WOCHE];
   if (wochen <= 0) then begin
      // Quests koennen Enden und Titel mitten in der Woche aendern
      call rl_ende_und_titel;
      return;
   end
   if (wochen > RL_MAX_NACHRECHNUNG) then wochen := RL_MAX_NACHRECHNUNG;

   call rl_welt_modifikatoren;
   while (wochen > 0) do begin
      call rl_ketten_woche(jetzt - wochen + 1);
      call rl_nr_woche(jetzt - wochen + 1);
      call rl_red_woche(jetzt - wochen + 1);
      tyrann := 0;
      ausbeutung := 0;
      h := 0;
      while (h < RL_ANZAHL_HAEUSER) do begin
         if (haus[rl_idx(h, RL_F_BESITZ)]) then begin
            if (haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_LEINE)) then
               tyrann := 1;
            if (haus[rl_idx(h, RL_F_ANTEIL)] == RL_ANTEIL_AUSBEUTERISCH) then
               ausbeutung := 1;
            call rl_stadtruf(h, jetzt - wochen + 1);
            haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + rl_rechne_woche(haus, h, h);
            if (haus[rl_idx(h, RL_F_GESCHLOSSEN)] > 0) then
               haus[rl_idx(h, RL_F_GESCHLOSSEN)] := haus[rl_idx(h, RL_F_GESCHLOSSEN)] - 1;
            // Baustelle: eine Woche weniger, danach wirkt das Modul (Phase 2)
            if (haus[rl_idx(h, RL_F_BAU_ID)]) then begin
               haus[rl_idx(h, RL_F_BAU_WOCHEN)] := haus[rl_idx(h, RL_F_BAU_WOCHEN)] - 1;
               if (haus[rl_idx(h, RL_F_BAU_WOCHEN)] <= 0) then begin
                  call rl_bau_fertig(haus, h);
                  display_msg(rl_haus_name(h) + ": " + rl_text(110));
               end
            end
            call rl_personalwechsel(h);
            if (haus[rl_idx(h, RL_F_KRISE)] != RL_EV_KEINS) then begin
               haus[rl_idx(h, RL_F_KRISENWOCHEN)] := haus[rl_idx(h, RL_F_KRISENWOCHEN)] + 1;
               // Nach drei Wochen ohne Loesung eskaliert die Krise (Phase 4, Abschnitt 4.1)
               if (haus[rl_idx(h, RL_F_KRISENWOCHEN)] == 3) then begin
                  haus[rl_idx(h, RL_F_MORAL)] := rl_max(0, haus[rl_idx(h, RL_F_MORAL)] - 10);
                  haus[rl_idx(h, RL_F_RUF)] := rl_max(0, haus[rl_idx(h, RL_F_RUF)] - 10);
                  display_msg(rl_haus_name(h) + ": " + rl_text(111));
               end
            end else begin
               call rl_ereignis_wurf(h);
            end
         end
         h := h + 1;
      end
      welt[RL_W_TYRANN_WOCHEN] := welt[RL_W_TYRANN_WOCHEN] + tyrann;
      welt[RL_W_AUSBEUTUNG_WOCHEN] := welt[RL_W_AUSBEUTUNG_WOCHEN] + ausbeutung;
      call rl_laeufer;
      wochen := wochen - 1;
   end
   welt[RL_W_WOCHE] := jetzt;
   call rl_ende_und_titel;
end

/* Stadt-Modifikatoren aus Phase 1 (Abschnitt 3.5) und Phase 3.
   Die Vanilla-Zustaende sind gegen die Original-Skripte geprueft. */
procedure rl_welt_modifikatoren begin
   variable m, global_boom := 0;

   if (Fallout2_enclave_destroyed) then global_boom := 10;

   // The Den: Sklavengilde aktiv +20 %, Metzger tot -25 %.
   // Der neue Metzger: die Gilde laeuft weiter, jetzt fuer den Spieler (+50 % dazu)
   if (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER) then m := 70;
   else if (metzger_dead) then m := -25;
   else m := 20;
   haus[rl_idx(RL_DEN, RL_F_STADTMOD)] := m + global_boom;

   // New Reno: Cat's Paw als Konkurrenz
   if (welt[RL_W_CATSPAW] == 0) then m := -15;
   else if (welt[RL_W_CATSPAW] == 1) then m := -5;
   else m := 0;
   haus[rl_idx(RL_NEW_RENO, RL_F_STADTMOD)] := m + global_boom;

   // Redding: Jet-Index, Wanamingo-Mine, Malamute, Kittys Kralle
   if ((global_var(GVAR_REDDING_JET_LEVEL) == JET_ON_CURE) or (global_var(GVAR_REDDING_JET_LEVEL) == JET_CURED)) then
      m := 25;                            // Antidot im Umlauf
   else if (rl_big_jesus_dead) then
      m := 10;                            // Mordino-Lieferkette gekappt
   else
      m := -20;                           // Jet-Flut
   if (global_var(GVAR_WANAMINGO_OCCUPADO) == WANAMINGO_CLEARED_OUT) then m := m + 30;
   if (welt[RL_W_MALAMUTE] == 0) then m := m - 10;
   if (welt[RL_W_KITTY_RIVALIN]) then m := m - 10;
   haus[rl_idx(RL_REDDING, RL_F_STADTMOD)] := m + global_boom;

   // Vault City: Gecko friedlich geloest (repariert oder optimiert, nicht zerstoert)
   m := 0;
   if ((global_var(GVAR_VAULT_GECKO_PLANT) == PLANT_REPAIRED)
       or (global_var(GVAR_VAULT_GECKO_PLANT) >= PLANT_FIXED_PLUS_KNOWN)) then m := 10;
   haus[rl_idx(RL_VAULT_CITY, RL_F_STADTMOD)] := m + global_boom;

   // NCR: Liga fuer eine reine Republik
   m := get_array([0, -15, -5, -10, 20, 0, 0], welt[RL_W_LIGA]);
   haus[rl_idx(RL_NCR, RL_F_STADTMOD)] := m + global_boom;

   // San Francisco: Hubologen
   m := get_array([-10, 0, 10], welt[RL_W_HUBOLOGEN]);
   haus[rl_idx(RL_SAN_FRAN, RL_F_STADTMOD)] := m + global_boom;

   // Laeuferroute: Marcus' Vertrauen folgt aus seiner Vanilla-Quest
   if ((welt[RL_W_MARCUS] == RL_MARCUS_KEIN) and (global_var(GVAR_BH_MISSING) >= MISSING_FINISHED_CASH)) then
      welt[RL_W_MARCUS] := RL_MARCUS_RELAIS;
end

/* Laeufer: Gewinne aus allen Haeusern ins Strumpfband (Phase 1, Abschnitt 4).
   Verlustchance = Hitze / 4 (hoechstens 25 %), ueber Broken Hills
   veraendert durch Marcus (Phase 3, Abschnitt 6). */
procedure rl_laeufer begin
   variable h, chance, faktor;

   if (haus[rl_idx(RL_NEW_RENO, RL_F_BESITZ)] == 0) then return;   // noch kein Hauptquartier

   h := 0;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if ((h != RL_NEW_RENO) and haus[rl_idx(h, RL_F_BESITZ)] and (haus[rl_idx(h, RL_F_KASSE)] > 0)) then begin
         faktor := 100;
         if ((h == RL_REDDING) or (h == RL_VAULT_CITY) or (h == RL_NCR)) then
            faktor := get_array([100, 50, 25, 125], welt[RL_W_MARCUS]);
         chance := rl_min(25, haus[rl_idx(h, RL_F_HITZE)] / 4) * faktor / 100;
         if (random(1, 100) <= chance) then begin
            display_msg(rl_haus_name(h) + ": " + rl_text(112) + haus[rl_idx(h, RL_F_KASSE)] + rl_text(113));
         end else begin
            welt[RL_W_HQ_KASSE] := welt[RL_W_HQ_KASSE] + haus[rl_idx(h, RL_F_KASSE)];
         end
         haus[rl_idx(h, RL_F_KASSE)] := 0;
      end
      h := h + 1;
   end
end

/* Ereigniswurf (Phase 4, Abschnitt 4.1) */
procedure rl_ereignis_wurf(variable h) begin
   variable chance, bedrohung, ereignis;

   if (haus[rl_idx(h, RL_F_GESCHLOSSEN)] > 0) then return;     // geschlossen: niemand da
   bedrohung := rl_stadt(h, RL_S_RISIKO) * 20 + haus[rl_idx(h, RL_F_HITZE)];
   chance := 10 + haus[rl_idx(h, RL_F_HITZE)] / 5
           + rl_max(0, bedrohung - haus[rl_idx(h, RL_F_SICHERHEIT)]) / 2;
   if (haus[rl_idx(h, RL_F_MORAL)] < 40) then chance := chance + 10;
   if (haus[rl_idx(h, RL_F_ZWANG)]) then chance := chance + 10;
   chance := rl_min(60, chance);
   if (random(1, 100) > chance) then return;

   ereignis := rl_ereignis_waehlen(h);
   if (ereignis == RL_EV_KEINS) then return;

   // Kleine Ereignisse loest die Madame mit ihrer Fuehrung
   if (random(1, 100) <= haus[rl_idx(h, RL_F_FUEHRUNG)]) then begin
      if (ereignis == RL_EV_STOFF) then
         haus[rl_idx(h, RL_F_MORAL)] := rl_max(0, haus[rl_idx(h, RL_F_MORAL)] - 2);
      else if (ereignis == RL_EV_FLUCHT) then begin
         if (rl_personal_verlust(haus, h, RL_VERLUST_FLUCHT) == 2) then
            display_msg(rl_haus_name(h) + ": " + rl_text(121));
      end
      else if (ereignis == RL_EV_FREIER) then
         haus[rl_idx(h, RL_F_RUF)] := rl_max(0, haus[rl_idx(h, RL_F_RUF)] - 2);
      else
         haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] - 100;
      display_msg(rl_haus_name(h) + ": " + rl_text(114));
   end else begin
      haus[rl_idx(h, RL_F_KRISE)] := ereignis;
      haus[rl_idx(h, RL_F_KRISENWOCHEN)] := 0;
      display_msg(rl_haus_name(h) + ": " + rl_text(115));
   end
end

/* Personalwechsel am Ende der Woche (Umsetzung 3, Phase 4 Abschnitt 1 und 2.2):
   1. Unter Moral 25 geht jede Woche eine Person (Gezwungene zuerst). Aus dem
      Pferch hinter dem Riegel aussen kuendigt niemand (Umsetzung 4).
   2. Ist ein Zimmer frei, sammelt das Haus Anwerbe-Punkte: Werben 2 pro Woche
      (mit dem Titel "Anstaendiges Haus" 4, Phase 6), Zwingen 4, dazu Zulauf
      ab Moral 75 +1 (nicht beim Zwingen). Je 4 Punkte kommt eine Person.
      Neue bringen ihre Qualitaet und Moral in den Hausdurchschnitt ein:
      geworben 40-60 und Moral 50, gezwungen 30-50 und Moral 15. Die Moral
      ist die der Leute, die gehen koennten: Zwangspersonal zaehlt nicht mit. */
procedure rl_personalwechsel(variable h) begin
   variable methode, punkte, n, frei, neu_q, neu_m, weg;

   if (haus[rl_idx(h, RL_F_MORAL)] < RL_FLUCHT_MORAL) then begin
      weg := rl_personal_verlust(haus, h, RL_VERLUST_ABGANG);
      if (weg == 1) then
         display_msg(rl_haus_name(h) + ": " + rl_text(119));
      else if (weg == 0) then
         display_msg(rl_haus_name(h) + ": " + rl_text(118));
   end

   n := haus[rl_idx(h, RL_F_PERSONAL)];
   if (n >= haus[rl_idx(h, RL_F_ZIMMER)]) then return;     // keine freie Stelle
   methode := haus[rl_idx(h, RL_F_ANWERBER)];
   punkte := 0;
   if (methode == RL_ANWERBER_WERBEN) then begin
      punkte := 2;
      if (global_var(GVAR_RL_TITEL_ANSTAND)) then punkte := 4;
   end else if (methode == RL_ANWERBER_ZWINGEN) then
      punkte := 4;
   if ((haus[rl_idx(h, RL_F_MORAL)] >= 75) and (methode != RL_ANWERBER_ZWINGEN)) then
      punkte := punkte + 1;
   if (punkte == 0) then return;

   punkte := haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] + punkte;
   if (punkte < RL_ANWERB_PUNKTE) then begin
      haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] := punkte;
      return;
   end
   haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] := punkte - RL_ANWERB_PUNKTE;

   if (methode == RL_ANWERBER_ZWINGEN) then begin
      neu_q := random(30, 50);
      neu_m := 15;
      haus[rl_idx(h, RL_F_GEZWUNGEN)] := haus[rl_idx(h, RL_F_GEZWUNGEN)] + 1;
      display_msg(rl_haus_name(h) + ": " + rl_text(117));
   end else begin
      neu_q := random(40, 60);
      neu_m := 50;
      display_msg(rl_haus_name(h) + ": " + rl_text(116));
   end
   if (methode != RL_ANWERBER_KEINER) then
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] - RL_ANWERB_KOPFGELD;
   frei := rl_max(0, n - haus[rl_idx(h, RL_F_ZWANG)]);
   haus[rl_idx(h, RL_F_QUALI)] := (haus[rl_idx(h, RL_F_QUALI)] * n + neu_q) / (n + 1);
   haus[rl_idx(h, RL_F_MORAL)] := (haus[rl_idx(h, RL_F_MORAL)] * frei + neu_m) / (frei + 1);
   haus[rl_idx(h, RL_F_PERSONAL)] := n + 1;
end

/* Gewichtete Auswahl (Phase 4, Abschnitt 4.2/4.3) */
procedure rl_ereignis_waehlen(variable h) begin
   variable g, summe, wurf, i;
   variable moral := haus[rl_idx(h, RL_F_MORAL)];
   variable module := haus[rl_idx(h, RL_F_MODULE)];

   g := temp_array(8, 0);
   // Soldaten ohne Krieg: selten, nach dem Fall der Enklave dreimal so oft
   g[RL_EV_SOLDATEN] := 3;
   if (Fallout2_enclave_destroyed) then g[RL_EV_SOLDATEN] := 9;
   // Der Stoff
   g[RL_EV_STOFF] := 10;
   if ((h == RL_REDDING) and (haus[rl_idx(h, RL_F_STADTMOD)] < 0)) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
   if (module bwand RL_MOD_JET_THEKE) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
   // New Reno: Mordino-Pate oder Jet-Vertrag doppelt, Wrights "Keine Chems im Haus!" halb (Phase 1)
   if (h == RL_NEW_RENO) then begin
      if ((welt[RL_W_NR_SEGEN] == RL_SEGEN_MORDINO) or welt[RL_W_JET_VERTRAG]) then
         g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
      else if (welt[RL_W_NR_SEGEN] == RL_SEGEN_WRIGHT) then
         g[RL_EV_STOFF] := g[RL_EV_STOFF] / 2;
   end
   if ((h == RL_REDDING) and rl_red_entzug(haus)) then g[RL_EV_STOFF] := g[RL_EV_STOFF] / 2;   // Entzugsstube
   if (moral < 40) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 3 / 2;
   // Razzia
   g[RL_EV_RAZZIA] := 5 + rl_stadt(h, RL_S_RISIKO) * 3 + haus[rl_idx(h, RL_F_HITZE)] / 2;
   // Gewalttaetiger Freier
   g[RL_EV_FREIER] := 5;
   if (haus[rl_idx(h, RL_F_SICHERHEIT)] < rl_stadt(h, RL_S_RISIKO) * 20) then g[RL_EV_FREIER] := 15;
   // Seuche nur ohne Krankenstube
   if ((module bwand RL_MOD_KRANKENSTUBE) == 0) then g[RL_EV_SEUCHE] := 8;
   // Griff in die Kasse
   g[RL_EV_KASSE] := 3;
   if (moral < 40) then g[RL_EV_KASSE] := 10;
   // Flucht
   if ((moral < RL_FLUCHT_MORAL) or haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_GEZWUNGEN)] > 0)) then
      g[RL_EV_FLUCHT] := 20;

   summe := 0;
   i := 1;
   while (i < 8) do begin
      summe := summe + g[i];
      i := i + 1;
   end
   if (summe <= 0) then return RL_EV_KEINS;

   wurf := random(1, summe);
   i := 1;
   while (i < 8) do begin
      wurf := wurf - g[i];
      if (wurf <= 0) then return i;
      i := i + 1;
   end
   return RL_EV_KEINS;
end

/* Stadtruf (Phase 6, Abschnitt 2): Das Haus faerbt auf den Ruf des Spielers
   in der Stadt ab. Schwellen der Vanilla-Welt: 15 = gemocht, 30 = verehrt,
   -15 = gehasst, -30 = verachtet. */
procedure rl_stadtruf(variable h, variable woche) begin
   variable gvar, ruf, dunkel;
   gvar := get_array([GVAR_TOWN_REP_THE_DEN, GVAR_TOWN_REP_NEW_RENO, GVAR_TOWN_REP_REDDING,
                      GVAR_TOWN_REP_VAULT_CITY, GVAR_TOWN_REP_NCR, GVAR_TOWN_REP_SAN_FRANCISCO], h);
   ruf := global_var(gvar);
   dunkel := haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_LEINE);

   if (dunkel and (woche % 2 == 0)) then
      ruf := ruf - 1;                           // Zwang spricht sich herum
   if ((haus[rl_idx(h, RL_F_HITZE)] >= 60) and (woche % 2 == 1)) then
      ruf := ruf - 1;                           // Gewalt und Razzien
   if ((not dunkel) and (haus[rl_idx(h, RL_F_MORAL)] >= 70) and (woche % 4 == 0) and (ruf < 15)) then
      ruf := ruf + 1;                           // ein anstaendiges Haus, hoechstens bis "gemocht"

   if (ruf != global_var(gvar)) then set_global_var(gvar, ruf);
end

/* Endslides und Titel (Phase 6, Abschnitte 3 und 4). Wird nach jeder
   Abrechnung neu berechnet, damit die Werte beim Abspann aktuell sind. */
procedure rl_ende_und_titel begin
   variable h, besitz := 0, kassen, gewinn := 0, alle_anstaendig := 1;
   variable tyrann, ende, nachsatz := RL_NACHSATZ_KEINER;

   if (welt[RL_W_AKTIV] == 0) then return;

   kassen := welt[RL_W_HQ_KASSE];
   h := 0;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if (haus[rl_idx(h, RL_F_BESITZ)]) then begin
         besitz := besitz + 1;
         kassen := kassen + haus[rl_idx(h, RL_F_KASSE)];
         gewinn := gewinn + haus[rl_idx(h, RL_F_GEWINN)];
         if (haus[rl_idx(h, RL_F_MORAL)] < 60) then alle_anstaendig := 0;
      end
      h := h + 1;
   end

   tyrann := (welt[RL_W_TYRANN_WOCHEN] >= 4)
             or (welt[RL_W_AUSBEUTUNG_WOCHEN] >= 26)
             or (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER)
             or (welt[RL_W_KETTEN] == RL_KETTEN_METZGERS_MANN)
             or (welt[RL_W_VIRGIN] == RL_VIRGIN_UMARMUNG);

   // Reihenfolge: Bankrott vor Tyrann vor Geschaeftsmann
   if ((besitz == 0) or ((gewinn < 0) and (kassen < 1000))) then
      ende := RL_ENDE_BANKROTT;
   else if (tyrann) then
      ende := RL_ENDE_TYRANN;
   else
      ende := RL_ENDE_GESCHAEFT;

   // Ein Nachsatz, nach Gewicht
   if (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER) then
      nachsatz := RL_NACHSATZ_KETTEN;
   else if (welt[RL_W_LIGA] == RL_LIGA_LEX_NEUN) then
      nachsatz := RL_NACHSATZ_LEX_NEUN;
   else if (welt[RL_W_LIGA] == RL_LIGA_ZERSCHLAGEN) then
      nachsatz := RL_NACHSATZ_SCHWEIGEN;
   else if (welt[RL_W_MARA] == 1) then
      nachsatz := RL_NACHSATZ_UEBERLEBENDE;
   else if (welt[RL_W_KITTY_RIVALIN]) then
      nachsatz := RL_NACHSATZ_KRALLE;
   else if ((welt[RL_W_VESPER] == 1) and haus[rl_idx(RL_NEW_RENO, RL_F_BESITZ)]) then
      nachsatz := RL_NACHSATZ_STIMME;

   call rl_setze_gvar(GVAR_RL_ENDE, ende);
   call rl_setze_gvar(GVAR_RL_NACHSATZ, nachsatz);

   // Titel im Charakterbogen (sichtbar, solange ungleich 0)
   call rl_setze_gvar(GVAR_RL_TITEL_SEELE, tyrann);
   call rl_setze_gvar(GVAR_RL_TITEL_ANSTAND,
                      (besitz >= 3) and alle_anstaendig and (not tyrann)
                      and (welt[RL_W_TYRANN_WOCHEN] == 0));
   call rl_setze_gvar(GVAR_RL_TITEL_FAMILIE,
                      (haus[rl_idx(RL_NEW_RENO, RL_F_KLASSE)] >= 3)
                      and (haus[rl_idx(RL_NEW_RENO, RL_F_EINFLUSS)] >= 80));
end

procedure rl_setze_gvar(variable gvar, variable wert) begin
   if (global_var(gvar) != wert) then set_global_var(gvar, wert);
end

/* Prolog: Ein gestohlener Schuldschein faellt Metzger nach zwei Wochen auf
   (Phase 1, Tabelle "Akquise"; Phase 3, Abschnitt 2.1). */
procedure rl_prolog_nachlauf begin
   if ((welt[RL_W_PROLOG_WEG] == RL_WEG_GESTOHLEN) and (welt[RL_W_METZGER] != RL_METZGER_FEIND)
       and (rl_woche_jetzt >= welt[RL_W_DIEBSTAHL_WOCHE] + 2)) then begin
      welt[RL_W_METZGER] := RL_METZGER_FEIND;
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(120));
   end
end

/* ------------------------------------------------------------------ */
/* Ketten, Akt 2-5 (Phase 3, Abschnitt 3.2; Umsetzung 5)               */
/* ------------------------------------------------------------------ */

/* Einmal je abgerechneter Woche (auch nachtraeglich), vor den Haeusern. */
procedure rl_ketten_woche(variable woche) begin
   variable akt := welt[RL_W_KETTEN];

   // Akt 2: eine Woche nach der Antwort auf Metzgers Angebot ist Mara im Keller
   if ((akt == RL_KETTEN_KELLER) and (welt[RL_W_MARA_WEG] == RL_MARA_KEINE)
       and (woche >= welt[RL_W_KETTEN_WOCHE] + 1)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_KELLER;
      if (welt[RL_W_ESSIE] == RL_ESSIE_DA) then
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(130));
      else
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(131));
   end

   // Metzgers Leute durchsuchen die Den: Ohne Zuflucht finden sie Mara.
   // Eine Zuflucht im Bau zaehlt schon: Die falsche Wand steht nach der ersten Nacht.
   if ((welt[RL_W_SUCHE] > 0) and (woche >= welt[RL_W_SUCHE])) then begin
      welt[RL_W_SUCHE] := 0;
      if (welt[RL_W_MARA_WEG] == RL_MARA_VERSTECKT) then begin
         if ((haus[rl_idx(RL_DEN, RL_F_MODULE)] bwand RL_MOD_ZUFLUCHT)
             or (haus[rl_idx(RL_DEN, RL_F_BAU_ID)] == RL_SONDER_BASIS + RL_SM_ZUFLUCHT + 1)) then begin
            display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(132));
         end else begin
            welt[RL_W_MARA_WEG] := RL_MARA_VERSCHLEPPT;
            welt[RL_W_METZGER]  := RL_METZGER_FEIND;
            call rl_haus_plus(haus, RL_DEN, RL_F_MORAL, -15);
            display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(133));
         end
      end
   end

   // Auftraege aus Akt 3
   if ((welt[RL_W_AUFTRAG] != RL_AUFTRAG_KEINER) and (woche >= welt[RL_W_AUFTRAG_WOCHE])) then
      call rl_auftrag_abschluss;

   // Akt 3 -> Akt 4 nach drei gelungenen Transporten oder Lieferungen
   if (akt == RL_KETTEN_KETTE) then begin
      if ((welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_FLUCHT) and (welt[RL_W_TRANSPORTE] >= RL_KETTEN_ZIEL)) then begin
         welt[RL_W_KETTEN] := RL_KETTEN_TYLER;
         welt[RL_W_KETTEN_WOCHE] := woche;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(139));
      end else if ((welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) and (welt[RL_W_LIEFERUNGEN] >= RL_KETTEN_ZIEL)) then begin
         welt[RL_W_KETTEN] := RL_KETTEN_TYLER;
         welt[RL_W_KETTEN_WOCHE] := woche;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(140));
      end
   end

   // Der stille Krieg: Metzger schlaegt alle sechs Wochen zurueck (Phase 4, 4.3)
   if ((welt[RL_W_KETTEN] == RL_KETTEN_STILLER_KRIEG) and (woche >= welt[RL_W_VERGELTUNG])) then begin
      welt[RL_W_VERGELTUNG] := woche + RL_VERGELTUNG_ABSTAND;
      if (haus[rl_idx(RL_DEN, RL_F_BESITZ)] and (haus[rl_idx(RL_DEN, RL_F_KRISE)] == RL_EV_KEINS)) then begin
         haus[rl_idx(RL_DEN, RL_F_KRISE)] := RL_EV_VERGELTUNG;
         haus[rl_idx(RL_DEN, RL_F_KRISENWOCHEN)] := 0;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(115));
      end
   end

   // Metzgers Mann: Anteil an den Lieferungen
   if ((welt[RL_W_KETTEN] == RL_KETTEN_METZGERS_MANN) and haus[rl_idx(RL_DEN, RL_F_BESITZ)]) then
      haus[rl_idx(RL_DEN, RL_F_KASSE)] := haus[rl_idx(RL_DEN, RL_F_KASSE)] + RL_METZGERS_MANN_WOCHE;

   // Mara kehrt zurueck, wenn die Linie im Fluchtzweig endet (Phase 4, 3.5)
   if (((welt[RL_W_KETTEN] == RL_KETTEN_GILDE_FAELLT) or (welt[RL_W_KETTEN] == RL_KETTEN_STILLER_KRIEG))
       and (welt[RL_W_MARA_WEG] == RL_MARA_SICHER) and (woche >= welt[RL_W_KETTEN_WOCHE] + 2)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_ZURUECK;
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(143));
   end

   // Mara geht, sobald irgendwo Zwangspersonal arbeitet, und nimmt Beweise mit
   if ((welt[RL_W_MARA_WEG] == RL_MARA_MADAME) and rl_zwang_irgendwo(haus)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_GEGANGEN;
      welt[RL_W_MARA] := 0;
      haus[rl_idx(RL_DEN, RL_F_FUEHRUNG)] := 45;
      haus[rl_idx(RL_DEN, RL_F_MORALBONUS)] := rl_max(0, haus[rl_idx(RL_DEN, RL_F_MORALBONUS)] - 1);
      call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 20);
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(144));
   end
end

/* Ein Auftrag aus Akt 3 ist abgeschlossen. Die Probe fiel beim Annehmen. */
procedure rl_auftrag_abschluss begin
   variable typ := welt[RL_W_AUFTRAG], betrag;
   welt[RL_W_AUFTRAG] := RL_AUFTRAG_KEINER;
   if (typ == RL_AUFTRAG_SUEDEN) then begin
      call rl_haus_plus(haus, RL_DEN, RL_F_HITZE, 10);
      if (welt[RL_W_AUFTRAG_WURF]) then begin
         welt[RL_W_TRANSPORTE] := welt[RL_W_TRANSPORTE] + 1;
         rl_karma(5);
         call rl_haus_plus(haus, RL_NCR, RL_F_EINFLUSS, 3);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(134));
      end else begin
         welt[RL_W_METZGER] := RL_METZGER_FEIND;
         call rl_haus_plus(haus, RL_DEN, RL_F_MORAL, -10);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(135));
      end
   end else begin
      // Lieferung nach Norden: Karma -15 in jedem Fall, die Rangers zaehlen mit
      rl_karma(-15);
      if (welt[RL_W_AUFTRAG_WURF]) then begin
         betrag := random(300, 600);
         welt[RL_W_LIEFERUNGEN] := welt[RL_W_LIEFERUNGEN] + 1;
         haus[rl_idx(RL_DEN, RL_F_KASSE)] := haus[rl_idx(RL_DEN, RL_F_KASSE)] + betrag;
         call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 10);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(136) + betrag + rl_text(137));
      end else begin
         call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 20);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(138));
      end
   end
end

/* Bei jedem Tick: Enden, die am Tod Metzgers haengen, und Tylers Tod (Vanilla). */
procedure rl_ketten_tick begin
   variable akt := welt[RL_W_KETTEN];
   if ((akt < RL_KETTEN_KELLER) or (akt == RL_KETTEN_GILDE_FAELLT) or (akt == RL_KETTEN_NEUER_METZGER)
       or (akt == RL_KETTEN_METZGERS_MANN)) then return;

   // Tyler ist in Vanilla schon tot: Akt 4 im Fluchtzweig entfaellt
   if ((akt == RL_KETTEN_TYLER) and (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_FLUCHT)
       and (welt[RL_W_TYLER] == RL_TYLER_OFFEN) and tyler_dead) then begin
      welt[RL_W_TYLER] := RL_TYLER_TOT;
      welt[RL_W_KETTEN] := RL_KETTEN_WAHL;
      welt[RL_W_KETTEN_WOCHE] := rl_woche_jetzt;
      akt := RL_KETTEN_WAHL;
   end

   if (not metzger_dead) then return;
   if (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) then begin
      // Wer im Tyrannen-Zweig Metzger stuerzt, erbt die Gilde
      if (akt >= RL_KETTEN_KETTE) then begin
         call rl_ketten_ende(haus, welt, RL_KETTEN_NEUER_METZGER);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(142));
      end
   end else if ((akt == RL_KETTEN_WAHL) or (akt == RL_KETTEN_STURM) or (akt == RL_KETTEN_STILLER_KRIEG)) then begin
      call rl_ketten_ende(haus, welt, RL_KETTEN_GILDE_FAELLT);
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(141));
   end
end

/* ------------------------------------------------------------------ */
/* New Reno und Hauptquartier (Umsetzung 7, rl_newreno.h)              */
/* ------------------------------------------------------------------ */

/* Bishops Brief: abgegeben, sobald der Spieler Westins Ranch betritt. Ist
   Westin tot, nimmt ihn sein Vormann; Bishop kommt es auf den Weg an. */
procedure rl_nr_brief begin
   if (welt == 0) then welt := rl_lade_welt;
   if (welt[RL_W_NR_BRIEF] == RL_BRIEF_UNTERWEGS) then
      welt[RL_W_NR_BRIEF] := RL_BRIEF_ABGEGEBEN;
   else if (welt[RL_W_NR_BRIEF] == RL_BRIEF_GEOEFFNET) then
      welt[RL_W_NR_BRIEF] := RL_BRIEF_ABGEGEBEN_OFFEN;
   else
      return;
   display_msg(rl_text(154));
end

/* Einmal je abgerechneter Woche, vor den Haeusern. */
procedure rl_nr_woche(variable woche) begin
   variable f, n;

   // Die Faelschung fliegt auf: Die Witwe kommt zurueck und will Geld
   if ((welt[RL_W_NR_FAELSCHUNG] > 0) and (woche >= welt[RL_W_NR_FAELSCHUNG])) then begin
      welt[RL_W_NR_FAELSCHUNG] := 0;
      if ((welt[RL_W_NR_TOTE] bwand RL_NR_TOT_WITWE) == 0) then begin
         welt[RL_W_NR_WITWE] := RL_WITWE_FORDERT;
         welt[RL_W_NR_WITWE_WOCHE] := woche + RL_WITWE_FRIST;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(150));
      end
   end
   if ((welt[RL_W_NR_WITWE] == RL_WITWE_FORDERT) and (woche >= welt[RL_W_NR_WITWE_WOCHE])) then begin
      welt[RL_W_NR_WITWE] := RL_WITWE_VERWEIGERT;
      call rl_haus_plus(haus, RL_NEW_RENO, RL_F_EINFLUSS, -10);
      call rl_haus_plus(haus, RL_NEW_RENO, RL_F_HITZE, 10);
      display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(151));
   end

   if (not rl_nr_besitz(haus)) then return;

   // Die Jet-Theke: Die Wrights vergessen das nicht
   if (haus[rl_idx(RL_NEW_RENO, RL_F_MODULE)] bwand RL_MOD_JET_THEKE) then
      call rl_nr_misstrauen(welt, RL_SEGEN_WRIGHT);

   // Misstrauische Familien, die noch leben, machen Druck
   n := 0;
   f := RL_SEGEN_MORDINO;
   while (f <= RL_SEGEN_BISHOP) do begin
      if (rl_nr_misstrauisch(welt, f) and not rl_familie_weg(f)) then n := n + 1;
      f := f + 1;
   end
   if (n > 0) then call rl_haus_plus(haus, RL_NEW_RENO, RL_F_HITZE, n * RL_MISSTRAUEN_HITZE);

   // Der Anteil am Shark Club, solange Bishop lebt
   if (welt[RL_W_SHARK_ANTEIL] and not rl_bishop_weg) then
      welt[RL_W_HQ_KASSE] := welt[RL_W_HQ_KASSE] + RL_SHARK_WOCHE;

   // Der Jet-Vertrag, solange es Mordinos gibt, die ihn einhalten
   if (welt[RL_W_JET_VERTRAG]) then begin
      if (rl_mordino_weg) then begin
         welt[RL_W_JET_VERTRAG] := 0;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(155));
      end else
         haus[rl_idx(RL_NEW_RENO, RL_F_KASSE)] := haus[rl_idx(RL_NEW_RENO, RL_F_KASSE)] + RL_JET_VERTRAG_WOCHE;
   end

   // Familientreffen: ab dem Familiensitz alle vier Wochen
   if (haus[rl_idx(RL_NEW_RENO, RL_F_KLASSE)] >= 3) then begin
      if ((welt[RL_W_TREFFEN_OFFEN] == RL_TREFFEN_KEINS) and (woche >= welt[RL_W_TREFFEN_WOCHE])) then begin
         welt[RL_W_TREFFEN_OFFEN] := rl_treffen_thema(welt);
         welt[RL_W_TREFFEN_FRIST] := woche + RL_TREFFEN_FRIST_WOCHEN;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(152));
      end else if ((welt[RL_W_TREFFEN_OFFEN] != RL_TREFFEN_KEINS) and (woche >= welt[RL_W_TREFFEN_FRIST])) then begin
         call rl_treffen_verpasst(haus, welt);
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(153));
      end
   end
end

/* ------------------------------------------------------------------ */
/* Redding (Umsetzung 8, rl_redding.h)                                 */
/* ------------------------------------------------------------------ */
procedure rl_red_woche(variable woche) begin
   variable h := RL_REDDING;

   // Die Wanamingo-Mine ist sauber (Vanilla): Marion nimmt die Schlacke unter seinen Schutz
   if ((global_var(GVAR_WANAMINGO_OCCUPADO) == WANAMINGO_CLEARED_OUT)
       and ((welt[RL_W_MARION] == RL_MARION_NEUTRAL) or (welt[RL_W_MARION] == RL_MARION_WACHSAM))) then begin
      call rl_red_marion_schutz(haus, welt);
      if (rl_red_besitz(haus)) then display_msg(rl_haus_name(h) + ": " + rl_text(162));
   end

   if (not rl_red_besitz(haus)) then return;

   // Die gezinkte Waage: Karma -2 je Woche, und Marion sucht
   if (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_WAAGE_GEZINKT) then begin
      rl_karma(-RL_WAAGE_KARMA);
      if (random(1, 100) <= rl_red_waage_chance(haus, welt)) then begin
         call rl_red_revolte(haus, welt);
         display_msg(rl_haus_name(h) + ": " + rl_text(160));
      end
   end

   // Der Malamute: Preiskrieg zaehlt nur Wochen mit Ramsch-Preisen; die Beteiligung zahlt
   if ((welt[RL_W_MALAMUTE] == 0) and (welt[RL_W_MALAMUTE_WEG] == RL_MALAMUTE_PREISKRIEG)
       and (haus[rl_idx(h, RL_F_PREISSTUFE)] == RL_PREIS_RAMSCH)) then begin
      welt[RL_W_MALAMUTE_WOCHEN] := welt[RL_W_MALAMUTE_WOCHEN] + 1;
      if (welt[RL_W_MALAMUTE_WOCHEN] >= RL_PREISKRIEG_WOCHEN) then begin
         welt[RL_W_MALAMUTE] := 1;
         display_msg(rl_haus_name(h) + ": " + rl_text(161));
      end
   end
   if (welt[RL_W_MALAMUTE_WEG] == RL_MALAMUTE_BETEILIGUNG) then
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + RL_MALAMUTE_ANTEIL_WOCHE;
end

#ifdef RL_DEBUG
/* Debug-Tasten:
     F9   Essie und Kolbe erscheinen neben dem Spieler, damit sich der Prolog
          auch ohne die Innenkarte RLDEN01 testen laesst. Figuren wie in
          RLDEN01: Durchschnittsbaeuerin und Schlaeger aus Vanilla.
     F11  direkt in die Gosse (Pruefliste der Karten)
     F8   auf Den Business 2 neben die Kellertreppe (Pruefliste der Karten) */
procedure rl_taste begin
   variable gedrueckt := get_sfall_arg;
   variable taste := get_sfall_arg;
   if (not gedrueckt) then return;
   if (taste == RL_TASTE_SPAWN) then
      call rl_debug_spawn;
   else if (taste == RL_TASTE_GOSSE) then
      load_map(RL_KARTE_GOSSE, 0);
   else if ((taste == RL_TASTE_TREPPE) and (cur_map_index == MAP_DEN_BUSINESS)) then
      move_to(dude_obj, RL_GOSSE_ANKUNFT_HEX, RL_GOSSE_TREPPE_EBENE);
end

procedure rl_debug_spawn begin
   variable obj;
   obj := create_object_sid(PID_AVERAGE_PEASANT_FEMALE, tile_num_in_direction(dude_tile, 0, 2), dude_elevation, SCRIPT_RLESSIE);
   obj := create_object_sid(PID_TOUGH_THUG_MALE, tile_num_in_direction(dude_tile, 1, 3), dude_elevation, SCRIPT_RLKOLBE);
   display_msg(rl_text(190));
end
#endif

procedure rl_haus_name(variable h) begin
   return rl_text(100 + h);
end

// Spieltexte stehen in text/<sprache>/game/rotlicht.msg, nicht im Code
procedure rl_text(variable n) begin
   if (rl_texte <= 0) then rl_texte := add_extra_msg_file(RL_TEXTDATEI);
   return message_str_game(rl_texte, n);
end

/* Selbsttest: rechnet das Beispielhaus aus Phase 1 (New Reno, mittlerer
   Ausbau) 30 Wochen lang mit allen drei Anteilsstufen. Die Ausgabe muss
   mit "python3 tools/economy_sim.py --vektoren" uebereinstimmen. */
procedure rl_selbsttest begin
   variable stufe, woche, gewinn, t := RL_TESTHAUS;

   stufe := 0;
   while (stufe <= RL_ANTEIL_FAIR) do begin
      haus[rl_idx(t, RL_F_BESITZ)]      := 0;
      haus[rl_idx(t, RL_F_ZIMMER)]      := 99;
      haus[rl_idx(t, RL_F_PERSONAL)]    := 99;
      haus[rl_idx(t, RL_F_QUALI)]       := 60;
      haus[rl_idx(t, RL_F_MORAL)]       := 50;
      haus[rl_idx(t, RL_F_RUF)]         := 55;
      haus[rl_idx(t, RL_F_AUSSTATTUNG)] := 50;
      haus[rl_idx(t, RL_F_SICHERHEIT)]  := 70;
      haus[rl_idx(t, RL_F_HITZE)]       := 0;
      haus[rl_idx(t, RL_F_PREISSTUFE)]  := RL_PREIS_STANDARD;
      haus[rl_idx(t, RL_F_ANTEIL)]      := stufe;
      haus[rl_idx(t, RL_F_BAR)]         := 1;
      haus[rl_idx(t, RL_F_NEBEN)]       := 0;
      haus[rl_idx(t, RL_F_MODULE)]      := RL_MOD_KONTOR;
      haus[rl_idx(t, RL_F_STUFEN)]      := 4;
      haus[rl_idx(t, RL_F_LOEHNE)]      := 310;
      haus[rl_idx(t, RL_F_MORALBONUS)]  := 0;
      haus[rl_idx(t, RL_F_STADTMOD)]    := 0;
      haus[rl_idx(t, RL_F_TRIBUTMOD)]   := 0;
      haus[rl_idx(t, RL_F_KRISE)]       := RL_EV_KEINS;
      haus[rl_idx(t, RL_F_ZWANG)]       := 0;
      woche := 1;
      while (woche <= 30) do begin
         gewinn := rl_rechne_woche(haus, t, t);
         debug_msg("RLTEST " + stufe + " W" + woche + " " + gewinn);
         woche := woche + 1;
      end
      stufe := stufe + 1;
   end
   display_msg(rl_text(191));
end
