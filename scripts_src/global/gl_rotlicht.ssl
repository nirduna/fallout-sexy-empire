/*
   gl_rotlicht.ssl - Globales Skript fuer "Rotlicht ueber dem Oedland"

   Aufgaben (Phase 5):
     1. Wochenabrechnung aller eigenen Haeuser, auch nachtraeglich fuer
        Wochen, in denen der Spieler unterwegs war (hoechstens 12).
     2. Stadt-Modifikatoren aus dem Zustand der Vanilla-Welt ableiten.
     3. Laeufer bringen das Geld ins Hauptquartier (Strumpfband).
     4. Ereigniswurf pro Haus: kleine Ereignisse loest die Madame,
        der Rest wird zur Krise, die der Spieler vor Ort loesen muss.
     5. Stadtruf, Titel und Endslides nachfuehren (Phase 6).
     6. Selbsttest gegen tools/economy_sim.py (mit -mRL_SELBSTTEST).
     7. Die Kellertreppe zur Gosse auf Den Business 2 setzen (Umsetzung 2).
     8. Personalwechsel: Anwerbung und Abgaenge (Umsetzung 3, Phase 4).
     9. Questline "Ketten", Akt 2-5: Akte, Auftraege, Durchsuchung, Vergeltung,
        Enden und Mara als Madame (Umsetzung 5, rl_ketten.h).
    10. New Reno (Umsetzung 7, rl_newreno.h): Bishops Brief bei Westin abgeben,
        die aufgeflogene Faelschung, Familientreffen, Shark Club, Jet-Vertrag,
        misstrauische Familien.
    11. Redding (Umsetzung 8, rl_redding.h): gezinkte Waage und Revolte,
        Malamute Saloon, Marion als Schutzherr nach der Wanamingo-Mine.
    12. Vault City (Umsetzung 9, rl_vaultcity.h): Schweigegeld je Hausklasse,
        die Akte, angekuendigte und sofortige Razzien der Garde.
    13. NCR (Umsetzung 10, rl_ncr.h): Lizenz und Auflage, Vortis' Leute und die
        Rangers, "Die Reinen" in fuenf Akten, Lex Neun.
    14. San Francisco (Umsetzung 11, rl_sanfran.h): der Spitzel fliegt auf,
        die Razzia der Shi-Inspektoren, die Hubologen fliegen davon.
    15. Blut auf der Virgin Street (Umsetzung 12, rl_virgin.h): die Akte mit
        Venuti, Kittys Abwerbung, die Umarmung in neuen Haeusern.
    16. Talente (Umsetzung 13, rl_talente.h): Reisen nach Gecko und Broken
        Hills, Ankunft, Loyalitaet, Rueckfall, Verrat, Abschied.
    17. Jobs und Laeuferroute (Umsetzung 14, rl_jobs.h): Tyler und der
        Polizist, Schutzgeld, Marcus sperrt oder hilft, der Umweg der Laeufer.
    18. Ereignisse vollstaendig (Umsetzung 15, rl_ereignisse.h): Razzien je
        Stadt, Eskalation je Krise, Tod im Haus, die Soldaten kommen wieder,
        Abwerbung und Ueberfall als Krisen, Inspektion der Liga.

   sfall laedt alle gl*.int beim Spielstart. Die Wochenlogik laeuft nur
   auf lokalen Karten; Reisezeit auf der Weltkarte wird beim naechsten
   Tick nachgerechnet.
*/

#define SCRIPT_REALNAME "gl_rotlicht"
#include "define.h"
#include "command.h"
#include "den.h"
#include "../headers/rotlicht.h"

// Aus newreno.h (der Header setzt ein Dialog-Skript mit NAME voraus):
// big_jesus_dead = get_new_reno_flag(big_jesus_dead_bit, 2)
#define rl_big_jesus_dead           gvar_bit(GVAR_NEW_RENO_FLAG_2, bit_26)

#define RL_TICK_FRAMES              (600)   // etwa alle 10 Sekunden pruefen
#define RL_TEXTDATEI                "rotlicht.msg"   // text/<sprache>/game/, per sfall geladen
#define RL_TASTE_SPAWN              (67)    // DIK_F9: Debug, Essie und Kolbe erscheinen lassen
#define RL_TASTE_GOSSE              (87)    // DIK_F11: Debug, direkt in die Gosse (RLDEN01)
#define RL_TASTE_TREPPE             (66)    // DIK_F8: Debug, auf Den Business 2 neben die Kellertreppe
// Nicht F10: Das ist im Spiel "Beenden". F1-F7 und F12 sind ebenfalls belegt.

procedure start;
procedure map_enter_p_proc;
procedure rl_tick;
procedure rl_gosse_eingang;
procedure rl_eingaenge;
procedure rl_personalwechsel(variable h);
procedure rl_welt_modifikatoren;
procedure rl_laeufer;
procedure rl_ereignis_wurf(variable h);
procedure rl_ereignis_waehlen(variable h);
procedure rl_haus_name(variable h);
procedure rl_stadtruf(variable h, variable woche);
procedure rl_ende_und_titel;
procedure rl_setze_gvar(variable gvar, variable wert);
procedure rl_selbsttest;
procedure rl_prolog_nachlauf;
procedure rl_text(variable n);
procedure rl_ketten_woche(variable woche);
procedure rl_ketten_tick;
procedure rl_auftrag_abschluss;
procedure rl_nr_woche(variable woche);
procedure rl_nr_brief;
procedure rl_red_woche(variable woche);
procedure rl_vc_woche(variable woche);
procedure rl_vc_razzia_kommt;
procedure rl_vc_razzia_meldung;
procedure rl_ncr_woche(variable woche);
procedure rl_ncr_lizenz_kommt;
procedure rl_reine_ende_meldung;
procedure rl_sf_woche(variable woche);
procedure rl_virgin_woche(variable woche);
procedure rl_kitty_woche(variable woche);
procedure rl_talente_woche(variable woche);
procedure rl_talente_reise;
procedure rl_talent_weg(variable wer, variable text);
procedure rl_jobs_woche;
procedure rl_marcus_pruefen;
procedure rl_jobs_reise;
procedure rl_krise_woche(variable h);
procedure rl_ereignisse_woche(variable woche);
#ifdef RL_DEBUG
procedure rl_taste;
procedure rl_debug_spawn;
#endif

variable haus;
variable welt;
variable rl_texte := -1;    // Datei-ID von rotlicht.msg

procedure start begin
   if (game_loaded) then begin
      set_global_script_repeat(RL_TICK_FRAMES);
      rl_texte := add_extra_msg_file(RL_TEXTDATEI);   // sfall vergisst die ID beim Laden
      haus := rl_lade_haeuser;
      welt := rl_lade_welt;
#ifdef RL_DEBUG
      register_hook_proc(HOOK_KEYPRESS, rl_taste);
#endif
#ifdef RL_SELBSTTEST
      call rl_selbsttest;
#endif
   end else begin
      call rl_tick;
   end
end

// sfall ruft map_enter_p_proc globaler Skripte bei jedem Kartenwechsel auf
procedure map_enter_p_proc begin
   if (cur_map_index == MAP_DEN_BUSINESS) then call rl_gosse_eingang;
   call rl_eingaenge;
   if (cur_map_index == MAP_NCR_WESTIN_RANCH) then call rl_nr_brief;
   call rl_talente_reise;
   call rl_jobs_reise;
end

/* Die Gosse: Die Vanilla-Karte Den Business 2 bleibt unveraendert. Die
   Kellertreppe wird gesetzt, sobald sie fehlt (auch nach dem Laden eines
   Spielstands, in dem sie noch nicht existierte; dafuer ruft auch der Tick
   diese Prozedur). Liegt sie nach einem Update an einem anderen Hex
   (RL_GOSSE_TREPPE_HEX geaendert), wird die alte entfernt. */
procedure rl_gosse_eingang begin
   variable alt, obj;
   if (welt == 0) then welt := rl_lade_welt;
   alt := welt[RL_W_GOSSE_TREPPE] - 1;
   if ((alt >= 0) and (alt != RL_GOSSE_TREPPE_HEX)) then begin
      obj := tile_contains_pid_obj(alt, RL_GOSSE_TREPPE_EBENE, RL_GOSSE_TREPPE_PID);
      if (obj) then destroy_object(obj);
   end
   if (tile_contains_pid_obj(RL_GOSSE_TREPPE_HEX, RL_GOSSE_TREPPE_EBENE, RL_GOSSE_TREPPE_PID) == 0) then
      obj := create_object_sid(RL_GOSSE_TREPPE_PID, RL_GOSSE_TREPPE_HEX, RL_GOSSE_TREPPE_EBENE, SCRIPT_RLGOSSE);
   welt[RL_W_GOSSE_TREPPE] := RL_GOSSE_TREPPE_HEX + 1;
end

/* Die weiteren Haeuser (Umsetzung 6): je Stadt eine Treppe auf der Vanilla-
   Stadtkarte, gesetzt wie die Kellertreppe der Gosse. */
procedure rl_eingaenge begin
   variable h, alt, obj, hexfeld;
   h := rl_haus_von_stadtkarte(cur_map_index);
   if (h <= 0) then return;
   if (welt == 0) then welt := rl_lade_welt;
   hexfeld := rl_eingang_hex(h);
   alt := welt[RL_W_EINGANG + h] - 1;
   if ((alt >= 0) and (alt != hexfeld)) then begin
      obj := tile_contains_pid_obj(alt, 0, RL_GOSSE_TREPPE_PID);
      if (obj) then destroy_object(obj);
   end
   if (tile_contains_pid_obj(hexfeld, 0, RL_GOSSE_TREPPE_PID) == 0) then
      obj := create_object_sid(RL_GOSSE_TREPPE_PID, hexfeld, 0, SCRIPT_RLTUER);
   welt[RL_W_EINGANG + h] := hexfeld + 1;
end

procedure rl_tick begin
   variable jetzt, wochen, h, tyrann, ausbeutung;

   if (cur_map_index == MAP_DEN_BUSINESS) then call rl_gosse_eingang;
   call rl_eingaenge;
   call rl_prolog_nachlauf;
   call rl_ncr_lizenz_kommt;       // auch, wenn noch kein Haus gehoert (Wartezeit der Lizenz)
   if (welt[RL_W_AKTIV] == 0) then return;
   call rl_ketten_tick;

   jetzt  := game_time_in_seconds / RL_SEKUNDEN_WOCHE;
   wochen := jetzt - welt[RL_W_WOCHE];
   if (wochen <= 0) then begin
      // Quests koennen Enden und Titel mitten in der Woche aendern
      call rl_ende_und_titel;
      return;
   end
   if (wochen > RL_MAX_NACHRECHNUNG) then wochen := RL_MAX_NACHRECHNUNG;

   call rl_welt_modifikatoren;
   while (wochen > 0) do begin
      call rl_ketten_woche(jetzt - wochen + 1);
      call rl_nr_woche(jetzt - wochen + 1);
      call rl_red_woche(jetzt - wochen + 1);
      call rl_vc_woche(jetzt - wochen + 1);
      call rl_ncr_woche(jetzt - wochen + 1);
      call rl_sf_woche(jetzt - wochen + 1);
      call rl_virgin_woche(jetzt - wochen + 1);
      call rl_kitty_woche(jetzt - wochen + 1);
      call rl_talente_woche(jetzt - wochen + 1);
      call rl_ereignisse_woche(jetzt - wochen + 1);
      tyrann := 0;
      ausbeutung := 0;
      h := 0;
      while (h < RL_ANZAHL_HAEUSER) do begin
         if (haus[rl_idx(h, RL_F_BESITZ)]) then begin
            if (haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_LEINE)) then
               tyrann := 1;
            if (haus[rl_idx(h, RL_F_ANTEIL)] == RL_ANTEIL_AUSBEUTERISCH) then
               ausbeutung := 1;
            call rl_stadtruf(h, jetzt - wochen + 1);
            haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + rl_rechne_woche(haus, h, h);
            if (haus[rl_idx(h, RL_F_GESCHLOSSEN)] > 0) then
               haus[rl_idx(h, RL_F_GESCHLOSSEN)] := haus[rl_idx(h, RL_F_GESCHLOSSEN)] - 1;
            // Baustelle: eine Woche weniger, danach wirkt das Modul (Phase 2)
            if (haus[rl_idx(h, RL_F_BAU_ID)]) then begin
               haus[rl_idx(h, RL_F_BAU_WOCHEN)] := haus[rl_idx(h, RL_F_BAU_WOCHEN)] - 1;
               if (haus[rl_idx(h, RL_F_BAU_WOCHEN)] <= 0) then begin
                  call rl_bau_fertig(haus, h);
                  display_msg(rl_haus_name(h) + ": " + rl_text(110));
               end
            end
            call rl_personalwechsel(h);
            if (haus[rl_idx(h, RL_F_KRISE)] != RL_EV_KEINS) then
               call rl_krise_woche(h);
            else
               call rl_ereignis_wurf(h);
         end
         h := h + 1;
      end
      if (rl_jobs_woche) then tyrann := 1;                         // Schutzgeld (Phase 3, 5.2)
      welt[RL_W_TYRANN_WOCHEN] := welt[RL_W_TYRANN_WOCHEN] + tyrann;
      welt[RL_W_AUSBEUTUNG_WOCHEN] := welt[RL_W_AUSBEUTUNG_WOCHEN] + ausbeutung;
      call rl_laeufer;
      wochen := wochen - 1;
   end
   welt[RL_W_WOCHE] := jetzt;
   call rl_ende_und_titel;
end

/* Stadt-Modifikatoren aus Phase 1 (Abschnitt 3.5) und Phase 3.
   Die Vanilla-Zustaende sind gegen die Original-Skripte geprueft. */
procedure rl_welt_modifikatoren begin
   variable m, global_boom := 0;

   if (Fallout2_enclave_destroyed) then global_boom := 10;

   // The Den: Sklavengilde aktiv +20 %, Metzger tot -25 %.
   // Der neue Metzger: die Gilde laeuft weiter, jetzt fuer den Spieler (+50 % dazu)
   if (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER) then m := 70;
   else if (metzger_dead) then m := -25;
   else m := 20;
   haus[rl_idx(RL_DEN, RL_F_STADTMOD)] := m + global_boom;

   // New Reno: Cat's Paw als Konkurrenz (0 offen, 1 Buendnis, 2 geloest, 3 bei den Mordinos)
   m := get_array([-15, -5, 0, -15], welt[RL_W_CATSPAW]);
   haus[rl_idx(RL_NEW_RENO, RL_F_STADTMOD)] := m + global_boom;

   // Redding: Jet-Index, Wanamingo-Mine, Malamute, Kittys Kralle
   if ((global_var(GVAR_REDDING_JET_LEVEL) == JET_ON_CURE) or (global_var(GVAR_REDDING_JET_LEVEL) == JET_CURED)) then
      m := 25;                            // Antidot im Umlauf
   else if (rl_big_jesus_dead or (welt[RL_W_VIRGIN] == RL_VIRGIN_LEERER_STUHL)) then
      m := 10;                            // Mordino-Lieferkette gekappt
   else
      m := -20;                           // Jet-Flut
   if (global_var(GVAR_WANAMINGO_OCCUPADO) == WANAMINGO_CLEARED_OUT) then m := m + 30;
   if (welt[RL_W_MALAMUTE] == 0) then m := m - 10;
   if (welt[RL_W_KITTY_RIVALIN]) then m := m - 10;
   haus[rl_idx(RL_REDDING, RL_F_STADTMOD)] := m + global_boom;

   // Vault City: Gecko friedlich geloest (repariert oder optimiert, nicht zerstoert)
   m := 0;
   if ((global_var(GVAR_VAULT_GECKO_PLANT) == PLANT_REPAIRED)
       or (global_var(GVAR_VAULT_GECKO_PLANT) >= PLANT_FIXED_PLUS_KNOWN)) then m := 10;
   haus[rl_idx(RL_VAULT_CITY, RL_F_STADTMOD)] := m + global_boom;

   // NCR: Liga fuer eine reine Republik. Lex Neun gilt nur fuer Haeuser mit fairem
   // Anteil, ohne Zwangsarbeit und mit Untersuchungen; sonst kommt Calloway zurueck.
   m := get_array([0, -15, -5, -10, 20, 0, 0], welt[RL_W_LIGA]);
   if ((welt[RL_W_LIGA] == RL_LIGA_LEX_NEUN)
       and ((haus[rl_idx(RL_NCR, RL_F_ANTEIL)] != RL_ANTEIL_FAIR) or (haus[rl_idx(RL_NCR, RL_F_ZWANG)] > 0)
            or (welt[RL_W_EREIGNIS_FLAGS] bwand RL_EF_LEX_VERWIRKT)
            or ((haus[rl_idx(RL_NCR, RL_F_MODULE)] bwand RL_MOD_KRANKENSTUBE) == 0))) then
      m := -15;
   if ((m < 0) and (haus[rl_idx(RL_NCR, RL_F_MODULE)] bwand RL_MOD_REGISTRATUR)) then
      m := m / 2;                                                    // Registratur: halbe Wirkung
   if (rl_woche_jetzt < welt[RL_W_REINE_BRAND_WOCHE]) then m := m - 40;   // abgebrannt
   haus[rl_idx(RL_NCR, RL_F_STADTMOD)] := m + global_boom;

   // San Francisco: Hubologen (0 offen, 1 entlarvt, 2 unterwandert, 3 Absprache);
   // wissen die Tanker-Leute vom Spitzel, bleiben sie weg
   if ((welt[RL_W_HUBOLOGEN] == RL_HUBOLOGEN_OFFEN) and rl_hubologen_weg) then
      welt[RL_W_HUBOLOGEN] := RL_HUBOLOGEN_ENTLARVT;
   m := get_array([-10, 0, 10, 0], welt[RL_W_HUBOLOGEN]);
   if (welt[RL_W_SF_SPITZEL_AUF]) then m := m - 10;
   haus[rl_idx(RL_SAN_FRAN, RL_F_STADTMOD)] := m + global_boom;

   // Gecko friedlich geloest: Vault City erinnert sich daran (Phase 3, 5.3)
   if (((global_var(GVAR_VAULT_GECKO_PLANT) == PLANT_REPAIRED) or (global_var(GVAR_VAULT_GECKO_PLANT) >= PLANT_FIXED_PLUS_KNOWN))
       and ((welt[RL_W_JOBS] bwand RL_JOB_GECKO) == 0)) then begin
      welt[RL_W_JOBS] := welt[RL_W_JOBS] bwor RL_JOB_GECKO;
      call rl_haus_plus(haus, RL_VAULT_CITY, RL_F_EINFLUSS, 10);
   end

   call rl_marcus_pruefen;
end

/* Laeuferroute (Phase 3, Abschnitt 6): Marcus' Vertrauen folgt aus seiner
   Vanilla-Quest; Slaver-Titel und der neue Metzger sperren die Stadt, und
   wer Marcus toetet, hat Broken Hills und jede Stadt gegen sich. */
procedure rl_marcus_pruefen begin
   variable h;
   if (global_var(GVAR_MARCUS_DEAD) and ((welt[RL_W_JOBS] bwand RL_JOB_MARCUS_TOT) == 0)) then begin
      welt[RL_W_JOBS] := welt[RL_W_JOBS] bwor RL_JOB_MARCUS_TOT;
      welt[RL_W_MARCUS] := RL_MARCUS_GESPERRT;
      h := 0;
      while (h < RL_ANZAHL_HAEUSER) do begin
         if (haus[rl_idx(h, RL_F_BESITZ)]) then call rl_haus_plus(haus, h, RL_F_HITZE, 10);
         h := h + 1;
      end
      display_msg(rl_text(232));
      return;
   end
   if (welt[RL_W_MARCUS] == RL_MARCUS_GESPERRT) then return;
   if ((global_var(GVAR_REPUTATION_SLAVER) == 1) or (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER)) then begin
      welt[RL_W_MARCUS] := RL_MARCUS_GESPERRT;
      if (haus[rl_idx(RL_NEW_RENO, RL_F_BESITZ)]) then display_msg(rl_text(233));
      return;
   end
   if ((welt[RL_W_MARCUS] == RL_MARCUS_KEIN) and (global_var(GVAR_BH_MISSING) >= MISSING_FINISHED_CASH)) then
      welt[RL_W_MARCUS] := RL_MARCUS_RELAIS;
end

/* Laeufer: Gewinne aus allen Haeusern ins Strumpfband (Phase 1, Abschnitt 4).
   Verlustchance = Hitze / 4 (hoechstens 25 %), ueber Broken Hills
   veraendert durch Marcus (Phase 3, Abschnitt 6). */
procedure rl_laeufer begin
   variable h, chance, faktor;

   if (haus[rl_idx(RL_NEW_RENO, RL_F_BESITZ)] == 0) then return;   // noch kein Hauptquartier

   // Der Umweg um Broken Hills: Was letzte Woche losging, kommt jetzt an
   if (welt[RL_W_HQ_UNTERWEGS] > 0) then begin
      welt[RL_W_HQ_KASSE] := welt[RL_W_HQ_KASSE] + welt[RL_W_HQ_UNTERWEGS];
      welt[RL_W_HQ_UNTERWEGS] := 0;
   end

   h := 0;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if ((h != RL_NEW_RENO) and haus[rl_idx(h, RL_F_BESITZ)] and (haus[rl_idx(h, RL_F_KASSE)] > 0)) then begin
         faktor := 100;
         if ((h == RL_REDDING) or (h == RL_VAULT_CITY) or (h == RL_NCR)) then
            faktor := get_array([100, 50, 25, 125], welt[RL_W_MARCUS]);
         chance := rl_min(25, haus[rl_idx(h, RL_F_HITZE)] / 4) * faktor / 100;
         if (random(1, 100) <= chance) then begin
            display_msg(rl_haus_name(h) + ": " + rl_text(112) + haus[rl_idx(h, RL_F_KASSE)] + rl_text(113));
            // Die Spur der Raeuber: eine Krise im Hauptquartier (Phase 4, 4.3)
            if (rl_krise_setzen(haus, RL_NEW_RENO, RL_EV_UEBERFALL)) then
               welt[RL_W_UEBERFALL_BETRAG] := haus[rl_idx(h, RL_F_KASSE)];
            else if (haus[rl_idx(RL_NEW_RENO, RL_F_KRISE)] == RL_EV_UEBERFALL) then
               welt[RL_W_UEBERFALL_BETRAG] := welt[RL_W_UEBERFALL_BETRAG] + haus[rl_idx(h, RL_F_KASSE)];
         end else if (faktor == 125) then begin
            welt[RL_W_HQ_UNTERWEGS] := welt[RL_W_HQ_UNTERWEGS] + haus[rl_idx(h, RL_F_KASSE)];   // eine Woche spaeter
         end else begin
            welt[RL_W_HQ_KASSE] := welt[RL_W_HQ_KASSE] + haus[rl_idx(h, RL_F_KASSE)];
         end
         haus[rl_idx(h, RL_F_KASSE)] := 0;
      end
      h := h + 1;
   end
end

/* Ereigniswurf (Phase 4, Abschnitt 4.1) */
procedure rl_ereignis_wurf(variable h) begin
   variable chance, bedrohung, ereignis, fuehrung;

   if (haus[rl_idx(h, RL_F_GESCHLOSSEN)] > 0) then return;     // geschlossen: niemand da
   bedrohung := (rl_stadt(h, RL_S_RISIKO) + haus[rl_idx(h, RL_F_RISIKO_MOD)]) * 20 + haus[rl_idx(h, RL_F_HITZE)];
   chance := 10 + haus[rl_idx(h, RL_F_HITZE)] / 5
           + rl_max(0, bedrohung - haus[rl_idx(h, RL_F_SICHERHEIT)]) / 2;
   if (haus[rl_idx(h, RL_F_MORAL)] < 40) then chance := chance + 10;
   if (haus[rl_idx(h, RL_F_ZWANG)]) then chance := chance + 10;
   chance := rl_min(60, chance);
   if (random(1, 100) > chance) then return;

   ereignis := rl_ereignis_waehlen(h);
   if (ereignis == RL_EV_KEINS) then return;

   // Die Inspektion der Liga wird sofort entschieden (Phase 4, 4.3)
   if (ereignis == RL_EV_INSPEKTION) then begin
      display_msg(rl_haus_name(h) + ": " + rl_text(rl_inspektion(haus, welt, h)));
      return;
   end

   // San Francisco: Die Inspektoren der Shi suchen die Schmuggelkammer (Phase 4, 4.2)
   if ((h == RL_SAN_FRAN) and (ereignis == RL_EV_RAZZIA) and (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_SCHMUGGEL)) then begin
      call rl_sf_razzia(haus, welt);
      display_msg(rl_haus_name(h) + ": " + rl_text(197));
      return;
   end

   // Talus erledigt gewalttaetige Freier selbst (Phase 4, 3.3)
   if ((ereignis == RL_EV_FREIER) and (h == rl_talus_haus(welt))) then return;

   // Razzien in der Den, in New Reno, Redding und der NCR: angekuendigt eine Woche vorher, sonst sofort
   if ((ereignis == RL_EV_RAZZIA) and rl_razzia_stadt(h)) then begin
      if (rl_razzia_angekuendigt(haus, welt, h)) then begin
         call rl_krise_setzen(haus, h, RL_EV_RAZZIA);
         display_msg(rl_haus_name(h) + ": " + rl_text(260));
      end else
         display_msg(rl_haus_name(h) + ": " + rl_text(rl_razzia_ausfuehren(haus, welt, h)));
      return;
   end

   // Die Soldaten und die Ereignisse aus Umsetzung 15 kann die Madame nicht allein loesen
   if ((ereignis == RL_EV_SOLDATEN) or (ereignis >= RL_EV_TOD)) then begin
      if (ereignis == RL_EV_RICHTER) then welt[RL_W_EREIGNIS_FLAGS] := welt[RL_W_EREIGNIS_FLAGS] bwor RL_EF_RICHTER;
      call rl_krise_setzen(haus, h, ereignis);
      display_msg(rl_haus_name(h) + ": " + rl_text(115));
      return;
   end

   // Vault City: Die Garde kommt nicht zur Madame, sie kommt ins Haus (Phase 4, 4.2)
   if ((h == RL_VAULT_CITY) and (ereignis == RL_EV_RAZZIA)) then begin
      call rl_vc_razzia_kommt;
      return;
   end

   // Kleine Ereignisse loest die Madame mit ihrer Fuehrung; Kittys Warnungen helfen in New Reno
   fuehrung := haus[rl_idx(h, RL_F_FUEHRUNG)];
   if ((h == RL_NEW_RENO) and (welt[RL_W_KITTY_WEG] == RL_KITTY_BUENDNIS)) then fuehrung := fuehrung + 20;
   if (random(1, 100) <= fuehrung) then begin
      if (ereignis == RL_EV_STOFF) then
         haus[rl_idx(h, RL_F_MORAL)] := rl_max(0, haus[rl_idx(h, RL_F_MORAL)] - 2);
      else if (ereignis == RL_EV_FLUCHT) then begin
         if (rl_personal_verlust(haus, h, RL_VERLUST_FLUCHT) == 2) then
            display_msg(rl_haus_name(h) + ": " + rl_text(121));
      end
      else if (ereignis == RL_EV_FREIER) then
         haus[rl_idx(h, RL_F_RUF)] := rl_max(0, haus[rl_idx(h, RL_F_RUF)] - 2);
      else
         haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] - 100;
      display_msg(rl_haus_name(h) + ": " + rl_text(114));
   end else begin
      haus[rl_idx(h, RL_F_KRISE)] := ereignis;
      haus[rl_idx(h, RL_F_KRISENWOCHEN)] := 0;
      display_msg(rl_haus_name(h) + ": " + rl_text(115));
   end
end

/* Personalwechsel am Ende der Woche (Umsetzung 3, Phase 4 Abschnitt 1 und 2.2):
   1. Unter Moral 25 geht jede Woche eine Person (Gezwungene zuerst). Aus dem
      Pferch hinter dem Riegel aussen kuendigt niemand (Umsetzung 4).
   2. Ist ein Zimmer frei, sammelt das Haus Anwerbe-Punkte: Werben 2 pro Woche
      (mit dem Titel "Anstaendiges Haus" 4, Phase 6), Zwingen 4, dazu Zulauf
      ab Moral 75 +1 (nicht beim Zwingen). Je 4 Punkte kommt eine Person.
      Neue bringen ihre Qualitaet und Moral in den Hausdurchschnitt ein:
      geworben 40-60 und Moral 50, gezwungen 30-50 und Moral 15. Die Moral
      ist die der Leute, die gehen koennten: Zwangspersonal zaehlt nicht mit. */
procedure rl_personalwechsel(variable h) begin
   variable methode, punkte, n, frei, neu_q, neu_m, weg;

   if (haus[rl_idx(h, RL_F_MORAL)] < RL_FLUCHT_MORAL) then begin
      weg := rl_personal_verlust(haus, h, RL_VERLUST_ABGANG);
      if (weg == 1) then
         display_msg(rl_haus_name(h) + ": " + rl_text(119));
      else if (weg == 0) then
         display_msg(rl_haus_name(h) + ": " + rl_text(118));
   end

   n := haus[rl_idx(h, RL_F_PERSONAL)];
   if (n >= haus[rl_idx(h, RL_F_ZIMMER)]) then return;     // keine freie Stelle
   methode := haus[rl_idx(h, RL_F_ANWERBER)];
   punkte := 0;
   if (methode == RL_ANWERBER_WERBEN) then begin
      punkte := 2;
      if (global_var(GVAR_RL_TITEL_ANSTAND)) then punkte := 4;
   end else if (methode == RL_ANWERBER_ZWINGEN) then
      punkte := 4;
   if ((haus[rl_idx(h, RL_F_MORAL)] >= 75) and (methode != RL_ANWERBER_ZWINGEN)) then
      punkte := punkte + 1;
   if ((h == RL_NEW_RENO) and (welt[RL_W_KITTY_WEG] == RL_KITTY_FUSION)) then
      punkte := punkte * 2;                             // Kitty kennt jedes Maedchen in New Reno
   if (punkte == 0) then return;

   punkte := haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] + punkte;
   if (punkte < RL_ANWERB_PUNKTE) then begin
      haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] := punkte;
      return;
   end
   haus[rl_idx(h, RL_F_ANWERB_PUNKTE)] := punkte - RL_ANWERB_PUNKTE;

   if (methode == RL_ANWERBER_ZWINGEN) then begin
      neu_q := random(30, 50);
      neu_m := 15;
      haus[rl_idx(h, RL_F_GEZWUNGEN)] := haus[rl_idx(h, RL_F_GEZWUNGEN)] + 1;
      display_msg(rl_haus_name(h) + ": " + rl_text(117));
   end else begin
      neu_q := random(40, 60);
      neu_m := 50;
      display_msg(rl_haus_name(h) + ": " + rl_text(116));
   end
   if (methode != RL_ANWERBER_KEINER) then
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] - RL_ANWERB_KOPFGELD;
   frei := rl_max(0, n - haus[rl_idx(h, RL_F_ZWANG)]);
   haus[rl_idx(h, RL_F_QUALI)] := (haus[rl_idx(h, RL_F_QUALI)] * n + neu_q) / (n + 1);
   haus[rl_idx(h, RL_F_MORAL)] := (haus[rl_idx(h, RL_F_MORAL)] * frei + neu_m) / (frei + 1);
   haus[rl_idx(h, RL_F_PERSONAL)] := n + 1;
end

/* Gewichtete Auswahl (Phase 4, Abschnitt 4.2/4.3) */
procedure rl_ereignis_waehlen(variable h) begin
   variable g, summe, wurf, i;
   variable moral := haus[rl_idx(h, RL_F_MORAL)];
   variable module := haus[rl_idx(h, RL_F_MODULE)];

   g := temp_array(RL_EV_ANZAHL, 0);
   // Soldaten ohne Krieg: vor dem Fall der Enklave nur im Strumpfband mit Salvatore
   // als Paten und in der Bilge, danach dreimal so oft und in jedem Haus (Phase 4, 4.2)
   if (Fallout2_enclave_destroyed) then
      g[RL_EV_SOLDATEN] := 9;
   else if (((h == RL_NEW_RENO) and (welt[RL_W_NR_SEGEN] == RL_SEGEN_SALVATORE)) or (h == RL_SAN_FRAN)) then
      g[RL_EV_SOLDATEN] := 3;
   // Der Stoff
   g[RL_EV_STOFF] := 10;
   if ((h == RL_REDDING) and (haus[rl_idx(h, RL_F_STADTMOD)] < 0)) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
   if (module bwand RL_MOD_JET_THEKE) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
   // New Reno: Mordino-Pate oder Jet-Vertrag doppelt, Wrights "Keine Chems im Haus!" halb (Phase 1)
   if (h == RL_NEW_RENO) then begin
      if ((welt[RL_W_NR_SEGEN] == RL_SEGEN_MORDINO) or welt[RL_W_JET_VERTRAG]
          or ((welt[RL_W_VIRGIN] == RL_VIRGIN_JET) and ((welt[RL_W_VIRGIN_FLAGS] bwand RL_VF_DEALER_WEG) == 0))) then
         g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;
      else if (welt[RL_W_NR_SEGEN] == RL_SEGEN_WRIGHT) then
         g[RL_EV_STOFF] := g[RL_EV_STOFF] / 2;
   end
   if ((h == RL_REDDING) and rl_red_entzug(haus)) then g[RL_EV_STOFF] := g[RL_EV_STOFF] / 2;   // Entzugsstube
   if ((h == RL_VAULT_CITY) and (welt[RL_W_ABIGAIL] == RL_TS_DA)) then g[RL_EV_STOFF] := g[RL_EV_STOFF] / 2;   // Abigail
   if ((welt[RL_W_JULIAN_WEG] == RL_JULIAN_TYRANN) and (welt[RL_W_JULIAN] == RL_TS_DA) and (module bwand RL_MOD_VIP)) then
      g[RL_EV_STOFF] := g[RL_EV_STOFF] * 2;                                     // Julian am Jet
   if (moral < 40) then g[RL_EV_STOFF] := g[RL_EV_STOFF] * 3 / 2;
   // Razzia
   g[RL_EV_RAZZIA] := 5 + (rl_stadt(h, RL_S_RISIKO) + haus[rl_idx(h, RL_F_RISIKO_MOD)]) * 3 + haus[rl_idx(h, RL_F_HITZE)] / 2;
   if (h == RL_VAULT_CITY) then begin
      // Siegt die Liga oder wird sie Verbuendete, uebernimmt Lynette ihre Linie; zerbricht sie, verliert Lynette eine Stimme
      if ((welt[RL_W_LIGA] == RL_LIGA_LEX_NEUN) or (welt[RL_W_LIGA] == RL_LIGA_VERBOT)) then
         g[RL_EV_RAZZIA] := g[RL_EV_RAZZIA] * 3 / 2;
      else if (welt[RL_W_LIGA] == RL_LIGA_ZERSCHLAGEN) then
         g[RL_EV_RAZZIA] := g[RL_EV_RAZZIA] / 2;
      if (welt[RL_W_ABIGAIL] == RL_TS_DA) then g[RL_EV_RAZZIA] := g[RL_EV_RAZZIA] * 3 / 4;   // sie kennt die Schichtplaene
      if (welt[RL_W_VC_LYNETTE]) then g[RL_EV_RAZZIA] := 0;          // Lynette haelt die Garde zurueck
   end
   // Die Shi sind misstrauisch, solange es die Schmuggelkammer gibt
   if ((h == RL_SAN_FRAN) and (module bwand RL_MOD_SCHMUGGEL)) then g[RL_EV_RAZZIA] := g[RL_EV_RAZZIA] + 10;
   // Gewalttaetiger Freier
   g[RL_EV_FREIER] := 5;
   if (haus[rl_idx(h, RL_F_SICHERHEIT)] < (rl_stadt(h, RL_S_RISIKO) + haus[rl_idx(h, RL_F_RISIKO_MOD)]) * 20) then g[RL_EV_FREIER] := 15;
   // Seuche nur ohne Krankenstube
   if ((module bwand RL_MOD_KRANKENSTUBE) == 0) then g[RL_EV_SEUCHE] := 8;
   // Griff in die Kasse
   g[RL_EV_KASSE] := 3;
   if (moral < 40) then g[RL_EV_KASSE] := 10;
   // Flucht
   if ((moral < RL_FLUCHT_MORAL) or haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_GEZWUNGEN)] > 0)) then
      g[RL_EV_FLUCHT] := 20;
   // Weitere Ereignisse (Umsetzung 15)
   if (module bwand RL_MOD_VIP) then g[RL_EV_STAMMKUNDE] := 5;
   if ((h == RL_NCR) and (welt[RL_W_LIGA] == RL_LIGA_LEX_NEUN)
       and ((welt[RL_W_EREIGNIS_FLAGS] bwand RL_EF_LEX_VERWIRKT) == 0)) then g[RL_EV_INSPEKTION] := 6;
   if ((h == RL_NEW_RENO) and (welt[RL_W_VESPER_STAND] == RL_TS_DA)) then g[RL_EV_GHUL] := 4;
   if ((h == RL_VAULT_CITY) and (welt[RL_W_ABIGAIL] == RL_TS_DA) and (module bwand RL_MOD_VIP)
       and ((welt[RL_W_EREIGNIS_FLAGS] bwand RL_EF_RICHTER) == 0)) then g[RL_EV_RICHTER] := 6;
   if ((welt[RL_W_DESERTEUR] == h + 1) and (rl_woche_jetzt >= welt[RL_W_DESERTEUR_WOCHE] + 4)) then
      g[RL_EV_BUNKER] := 5;

   summe := 0;
   i := 1;
   while (i < RL_EV_ANZAHL) do begin
      summe := summe + g[i];
      i := i + 1;
   end
   if (summe <= 0) then return RL_EV_KEINS;

   wurf := random(1, summe);
   i := 1;
   while (i < RL_EV_ANZAHL) do begin
      wurf := wurf - g[i];
      if (wurf <= 0) then return i;
      i := i + 1;
   end
   return RL_EV_KEINS;
end

/* Stadtruf (Phase 6, Abschnitt 2): Das Haus faerbt auf den Ruf des Spielers
   in der Stadt ab. Schwellen der Vanilla-Welt: 15 = gemocht, 30 = verehrt,
   -15 = gehasst, -30 = verachtet. */
procedure rl_stadtruf(variable h, variable woche) begin
   variable gvar, ruf, dunkel;
   gvar := get_array([GVAR_TOWN_REP_THE_DEN, GVAR_TOWN_REP_NEW_RENO, GVAR_TOWN_REP_REDDING,
                      GVAR_TOWN_REP_VAULT_CITY, GVAR_TOWN_REP_NCR, GVAR_TOWN_REP_SAN_FRANCISCO], h);
   ruf := global_var(gvar);
   dunkel := haus[rl_idx(h, RL_F_ZWANG)] or (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_LEINE);

   if (dunkel and (woche % 2 == 0)) then
      ruf := ruf - 1;                           // Zwang spricht sich herum
   if ((haus[rl_idx(h, RL_F_HITZE)] >= 60) and (woche % 2 == 1)) then
      ruf := ruf - 1;                           // Gewalt und Razzien
   if ((not dunkel) and (haus[rl_idx(h, RL_F_MORAL)] >= 70) and (woche % 4 == 0) and (ruf < 15)) then
      ruf := ruf + 1;                           // ein anstaendiges Haus, hoechstens bis "gemocht"

   if (ruf != global_var(gvar)) then set_global_var(gvar, ruf);
end

/* Endslides und Titel (Phase 6, Abschnitte 3 und 4). Wird nach jeder
   Abrechnung neu berechnet, damit die Werte beim Abspann aktuell sind. */
procedure rl_ende_und_titel begin
   variable h, besitz := 0, kassen, gewinn := 0, alle_anstaendig := 1;
   variable tyrann, ende, nachsatz := RL_NACHSATZ_KEINER;

   if (welt[RL_W_AKTIV] == 0) then return;

   kassen := welt[RL_W_HQ_KASSE];
   h := 0;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if (haus[rl_idx(h, RL_F_BESITZ)]) then begin
         besitz := besitz + 1;
         kassen := kassen + haus[rl_idx(h, RL_F_KASSE)];
         gewinn := gewinn + haus[rl_idx(h, RL_F_GEWINN)];
         if (haus[rl_idx(h, RL_F_MORAL)] < 60) then alle_anstaendig := 0;
      end
      h := h + 1;
   end

   tyrann := (welt[RL_W_TYRANN_WOCHEN] >= 4)
             or (welt[RL_W_AUSBEUTUNG_WOCHEN] >= 26)
             or (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER)
             or (welt[RL_W_KETTEN] == RL_KETTEN_METZGERS_MANN)
             or (welt[RL_W_VIRGIN] == RL_VIRGIN_UMARMUNG);

   // Reihenfolge: Bankrott vor Tyrann vor Geschaeftsmann
   if ((besitz == 0) or ((gewinn < 0) and (kassen < 1000))) then
      ende := RL_ENDE_BANKROTT;
   else if (tyrann) then
      ende := RL_ENDE_TYRANN;
   else
      ende := RL_ENDE_GESCHAEFT;

   // Ein Nachsatz, nach Gewicht
   if (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER) then
      nachsatz := RL_NACHSATZ_KETTEN;
   else if (welt[RL_W_LIGA] == RL_LIGA_LEX_NEUN) then
      nachsatz := RL_NACHSATZ_LEX_NEUN;
   else if (welt[RL_W_LIGA] == RL_LIGA_ZERSCHLAGEN) then
      nachsatz := RL_NACHSATZ_SCHWEIGEN;
   else if (welt[RL_W_MARA] == 1) then
      nachsatz := RL_NACHSATZ_UEBERLEBENDE;
   else if (welt[RL_W_KITTY_RIVALIN]) then
      nachsatz := RL_NACHSATZ_KRALLE;
   else if ((welt[RL_W_VESPER] == 1) and haus[rl_idx(RL_NEW_RENO, RL_F_BESITZ)]) then
      nachsatz := RL_NACHSATZ_STIMME;

   call rl_setze_gvar(GVAR_RL_ENDE, ende);
   call rl_setze_gvar(GVAR_RL_NACHSATZ, nachsatz);

   // Titel im Charakterbogen (sichtbar, solange ungleich 0)
   call rl_setze_gvar(GVAR_RL_TITEL_SEELE, tyrann);
   call rl_setze_gvar(GVAR_RL_TITEL_ANSTAND,
                      (besitz >= 3) and alle_anstaendig and (not tyrann)
                      and (welt[RL_W_TYRANN_WOCHEN] == 0));
   call rl_setze_gvar(GVAR_RL_TITEL_FAMILIE,
                      (haus[rl_idx(RL_NEW_RENO, RL_F_KLASSE)] >= 3)
                      and (haus[rl_idx(RL_NEW_RENO, RL_F_EINFLUSS)] >= 80));
end

procedure rl_setze_gvar(variable gvar, variable wert) begin
   if (global_var(gvar) != wert) then set_global_var(gvar, wert);
end

/* Prolog: Ein gestohlener Schuldschein faellt Metzger nach zwei Wochen auf
   (Phase 1, Tabelle "Akquise"; Phase 3, Abschnitt 2.1). */
procedure rl_prolog_nachlauf begin
   if ((welt[RL_W_PROLOG_WEG] == RL_WEG_GESTOHLEN) and (welt[RL_W_METZGER] != RL_METZGER_FEIND)
       and (rl_woche_jetzt >= welt[RL_W_DIEBSTAHL_WOCHE] + 2)) then begin
      welt[RL_W_METZGER] := RL_METZGER_FEIND;
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(120));
   end
end

/* ------------------------------------------------------------------ */
/* Ketten, Akt 2-5 (Phase 3, Abschnitt 3.2; Umsetzung 5)               */
/* ------------------------------------------------------------------ */

/* Einmal je abgerechneter Woche (auch nachtraeglich), vor den Haeusern. */
procedure rl_ketten_woche(variable woche) begin
   variable akt := welt[RL_W_KETTEN];

   // Akt 2: eine Woche nach der Antwort auf Metzgers Angebot ist Mara im Keller
   if ((akt == RL_KETTEN_KELLER) and (welt[RL_W_MARA_WEG] == RL_MARA_KEINE)
       and (woche >= welt[RL_W_KETTEN_WOCHE] + 1)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_KELLER;
      if (welt[RL_W_ESSIE] == RL_ESSIE_DA) then
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(130));
      else
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(131));
   end

   // Metzgers Leute durchsuchen die Den: Ohne Zuflucht finden sie Mara.
   // Eine Zuflucht im Bau zaehlt schon: Die falsche Wand steht nach der ersten Nacht.
   if ((welt[RL_W_SUCHE] > 0) and (woche >= welt[RL_W_SUCHE])) then begin
      welt[RL_W_SUCHE] := 0;
      if (welt[RL_W_MARA_WEG] == RL_MARA_VERSTECKT) then begin
         if ((haus[rl_idx(RL_DEN, RL_F_MODULE)] bwand RL_MOD_ZUFLUCHT)
             or (haus[rl_idx(RL_DEN, RL_F_BAU_ID)] == RL_SONDER_BASIS + RL_SM_ZUFLUCHT + 1)) then begin
            display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(132));
         end else begin
            welt[RL_W_MARA_WEG] := RL_MARA_VERSCHLEPPT;
            welt[RL_W_METZGER]  := RL_METZGER_FEIND;
            call rl_haus_plus(haus, RL_DEN, RL_F_MORAL, -15);
            display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(133));
         end
      end
   end

   // Auftraege aus Akt 3
   if ((welt[RL_W_AUFTRAG] != RL_AUFTRAG_KEINER) and (woche >= welt[RL_W_AUFTRAG_WOCHE])) then
      call rl_auftrag_abschluss;

   // Akt 3 -> Akt 4 nach drei gelungenen Transporten oder Lieferungen
   if (akt == RL_KETTEN_KETTE) then begin
      if ((welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_FLUCHT) and (welt[RL_W_TRANSPORTE] >= RL_KETTEN_ZIEL)) then begin
         welt[RL_W_KETTEN] := RL_KETTEN_TYLER;
         welt[RL_W_KETTEN_WOCHE] := woche;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(139));
      end else if ((welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) and (welt[RL_W_LIEFERUNGEN] >= RL_KETTEN_ZIEL)) then begin
         welt[RL_W_KETTEN] := RL_KETTEN_TYLER;
         welt[RL_W_KETTEN_WOCHE] := woche;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(140));
      end
   end

   // Der stille Krieg: Metzger schlaegt alle sechs Wochen zurueck (Phase 4, 4.3)
   if ((welt[RL_W_KETTEN] == RL_KETTEN_STILLER_KRIEG) and (woche >= welt[RL_W_VERGELTUNG])) then begin
      welt[RL_W_VERGELTUNG] := woche + RL_VERGELTUNG_ABSTAND;
      if (haus[rl_idx(RL_DEN, RL_F_BESITZ)] and (haus[rl_idx(RL_DEN, RL_F_KRISE)] == RL_EV_KEINS)) then begin
         haus[rl_idx(RL_DEN, RL_F_KRISE)] := RL_EV_VERGELTUNG;
         haus[rl_idx(RL_DEN, RL_F_KRISENWOCHEN)] := 0;
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(115));
      end
   end

   // Metzgers Mann: Anteil an den Lieferungen
   if ((welt[RL_W_KETTEN] == RL_KETTEN_METZGERS_MANN) and haus[rl_idx(RL_DEN, RL_F_BESITZ)]) then
      haus[rl_idx(RL_DEN, RL_F_KASSE)] := haus[rl_idx(RL_DEN, RL_F_KASSE)] + RL_METZGERS_MANN_WOCHE;

   // Mara kehrt zurueck, wenn die Linie im Fluchtzweig endet (Phase 4, 3.5)
   if (((welt[RL_W_KETTEN] == RL_KETTEN_GILDE_FAELLT) or (welt[RL_W_KETTEN] == RL_KETTEN_STILLER_KRIEG))
       and (welt[RL_W_MARA_WEG] == RL_MARA_SICHER) and (woche >= welt[RL_W_KETTEN_WOCHE] + 2)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_ZURUECK;
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(143));
   end

   // Mara geht, sobald irgendwo Zwangspersonal arbeitet, und nimmt Beweise mit
   if ((welt[RL_W_MARA_WEG] == RL_MARA_MADAME) and rl_zwang_irgendwo(haus)) then begin
      welt[RL_W_MARA_WEG] := RL_MARA_GEGANGEN;
      welt[RL_W_MARA] := 0;
      haus[rl_idx(RL_DEN, RL_F_FUEHRUNG)] := 45;
      haus[rl_idx(RL_DEN, RL_F_MORALBONUS)] := rl_max(0, haus[rl_idx(RL_DEN, RL_F_MORALBONUS)] - 1);
      call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 20);
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(144));
   end
end

/* Ein Auftrag aus Akt 3 ist abgeschlossen. Die Probe fiel beim Annehmen. */
procedure rl_auftrag_abschluss begin
   variable typ := welt[RL_W_AUFTRAG], betrag;
   welt[RL_W_AUFTRAG] := RL_AUFTRAG_KEINER;
   if (typ == RL_AUFTRAG_SUEDEN) then begin
      call rl_haus_plus(haus, RL_DEN, RL_F_HITZE, 10);
      if (welt[RL_W_AUFTRAG_WURF]) then begin
         welt[RL_W_TRANSPORTE] := welt[RL_W_TRANSPORTE] + 1;
         rl_karma(5);
         call rl_haus_plus(haus, RL_NCR, RL_F_EINFLUSS, 3);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(134));
      end else begin
         welt[RL_W_METZGER] := RL_METZGER_FEIND;
         call rl_haus_plus(haus, RL_DEN, RL_F_MORAL, -10);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(135));
      end
   end else begin
      // Lieferung nach Norden: Karma -15 in jedem Fall, die Rangers zaehlen mit
      rl_karma(-15);
      if (welt[RL_W_AUFTRAG_WURF]) then begin
         betrag := random(300, 600);
         welt[RL_W_LIEFERUNGEN] := welt[RL_W_LIEFERUNGEN] + 1;
         haus[rl_idx(RL_DEN, RL_F_KASSE)] := haus[rl_idx(RL_DEN, RL_F_KASSE)] + betrag;
         call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 10);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(136) + betrag + rl_text(137));
      end else begin
         call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, 20);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(138));
      end
   end
end

/* Bei jedem Tick: Enden, die am Tod Metzgers haengen, und Tylers Tod (Vanilla). */
procedure rl_ketten_tick begin
   variable akt := welt[RL_W_KETTEN];
   if ((akt < RL_KETTEN_KELLER) or (akt == RL_KETTEN_GILDE_FAELLT) or (akt == RL_KETTEN_NEUER_METZGER)
       or (akt == RL_KETTEN_METZGERS_MANN)) then return;

   // Tyler ist in Vanilla schon tot: Akt 4 im Fluchtzweig entfaellt
   if ((akt == RL_KETTEN_TYLER) and (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_FLUCHT)
       and (welt[RL_W_TYLER] == RL_TYLER_OFFEN) and tyler_dead) then begin
      welt[RL_W_TYLER] := RL_TYLER_TOT;
      welt[RL_W_KETTEN] := RL_KETTEN_WAHL;
      welt[RL_W_KETTEN_WOCHE] := rl_woche_jetzt;
      akt := RL_KETTEN_WAHL;
   end

   if (not metzger_dead) then return;
   if (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) then begin
      // Wer im Tyrannen-Zweig Metzger stuerzt, erbt die Gilde
      if (akt >= RL_KETTEN_KETTE) then begin
         call rl_ketten_ende(haus, welt, RL_KETTEN_NEUER_METZGER);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(142));
      end
   end else if ((akt == RL_KETTEN_WAHL) or (akt == RL_KETTEN_STURM) or (akt == RL_KETTEN_STILLER_KRIEG)) then begin
      call rl_ketten_ende(haus, welt, RL_KETTEN_GILDE_FAELLT);
      display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(141));
   end
end

/* ------------------------------------------------------------------ */
/* New Reno und Hauptquartier (Umsetzung 7, rl_newreno.h)              */
/* ------------------------------------------------------------------ */

/* Bishops Brief: abgegeben, sobald der Spieler Westins Ranch betritt. Ist
   Westin tot, nimmt ihn sein Vormann; Bishop kommt es auf den Weg an. */
procedure rl_nr_brief begin
   if (welt == 0) then welt := rl_lade_welt;
   if (welt[RL_W_NR_BRIEF] == RL_BRIEF_UNTERWEGS) then
      welt[RL_W_NR_BRIEF] := RL_BRIEF_ABGEGEBEN;
   else if (welt[RL_W_NR_BRIEF] == RL_BRIEF_GEOEFFNET) then
      welt[RL_W_NR_BRIEF] := RL_BRIEF_ABGEGEBEN_OFFEN;
   else
      return;
   display_msg(rl_text(154));
end

/* Einmal je abgerechneter Woche, vor den Haeusern. */
procedure rl_nr_woche(variable woche) begin
   variable f, n;

   // Die Faelschung fliegt auf: Die Witwe kommt zurueck und will Geld
   if ((welt[RL_W_NR_FAELSCHUNG] > 0) and (woche >= welt[RL_W_NR_FAELSCHUNG])) then begin
      welt[RL_W_NR_FAELSCHUNG] := 0;
      if ((welt[RL_W_NR_TOTE] bwand RL_NR_TOT_WITWE) == 0) then begin
         welt[RL_W_NR_WITWE] := RL_WITWE_FORDERT;
         welt[RL_W_NR_WITWE_WOCHE] := woche + RL_WITWE_FRIST;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(150));
      end
   end
   if ((welt[RL_W_NR_WITWE] == RL_WITWE_FORDERT) and (woche >= welt[RL_W_NR_WITWE_WOCHE])) then begin
      welt[RL_W_NR_WITWE] := RL_WITWE_VERWEIGERT;
      call rl_haus_plus(haus, RL_NEW_RENO, RL_F_EINFLUSS, -10);
      call rl_haus_plus(haus, RL_NEW_RENO, RL_F_HITZE, 10);
      display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(151));
   end

   if (not rl_nr_besitz(haus)) then return;

   // Die Jet-Theke: Die Wrights vergessen das nicht
   if (haus[rl_idx(RL_NEW_RENO, RL_F_MODULE)] bwand RL_MOD_JET_THEKE) then
      call rl_nr_misstrauen(welt, RL_SEGEN_WRIGHT);

   // Misstrauische Familien, die noch leben, machen Druck
   n := 0;
   f := RL_SEGEN_MORDINO;
   while (f <= RL_SEGEN_BISHOP) do begin
      if (rl_nr_misstrauisch(welt, f) and not rl_familie_weg(f)) then n := n + 1;
      f := f + 1;
   end
   if (n > 0) then call rl_haus_plus(haus, RL_NEW_RENO, RL_F_HITZE, n * RL_MISSTRAUEN_HITZE);

   // Der Anteil am Shark Club, solange Bishop lebt
   if (welt[RL_W_SHARK_ANTEIL] and not rl_bishop_weg) then
      welt[RL_W_HQ_KASSE] := welt[RL_W_HQ_KASSE] + RL_SHARK_WOCHE;

   // Der Jet-Vertrag, solange es Mordinos gibt, die ihn einhalten
   if (welt[RL_W_JET_VERTRAG]) then begin
      if (rl_mordino_weg) then begin
         welt[RL_W_JET_VERTRAG] := 0;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(155));
      end else
         haus[rl_idx(RL_NEW_RENO, RL_F_KASSE)] := haus[rl_idx(RL_NEW_RENO, RL_F_KASSE)] + RL_JET_VERTRAG_WOCHE;
   end

   // Familientreffen: ab dem Familiensitz alle vier Wochen
   if (haus[rl_idx(RL_NEW_RENO, RL_F_KLASSE)] >= 3) then begin
      if ((welt[RL_W_TREFFEN_OFFEN] == RL_TREFFEN_KEINS) and (woche >= welt[RL_W_TREFFEN_WOCHE])) then begin
         welt[RL_W_TREFFEN_OFFEN] := rl_treffen_thema(welt);
         welt[RL_W_TREFFEN_FRIST] := woche + RL_TREFFEN_FRIST_WOCHEN;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(152));
      end else if ((welt[RL_W_TREFFEN_OFFEN] != RL_TREFFEN_KEINS) and (woche >= welt[RL_W_TREFFEN_FRIST])) then begin
         call rl_treffen_verpasst(haus, welt);
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(153));
      end
   end
end

/* ------------------------------------------------------------------ */
/* Redding (Umsetzung 8, rl_redding.h)                                 */
/* ------------------------------------------------------------------ */
procedure rl_red_woche(variable woche) begin
   variable h := RL_REDDING;

   // Die Wanamingo-Mine ist sauber (Vanilla): Marion nimmt die Schlacke unter seinen Schutz
   if ((global_var(GVAR_WANAMINGO_OCCUPADO) == WANAMINGO_CLEARED_OUT)
       and ((welt[RL_W_MARION] == RL_MARION_NEUTRAL) or (welt[RL_W_MARION] == RL_MARION_WACHSAM))) then begin
      call rl_red_marion_schutz(haus, welt);
      if (rl_red_besitz(haus)) then display_msg(rl_haus_name(h) + ": " + rl_text(162));
   end

   if (not rl_red_besitz(haus)) then return;

   // Die gezinkte Waage: Karma -2 je Woche, und Marion sucht
   if (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_WAAGE_GEZINKT) then begin
      rl_karma(-RL_WAAGE_KARMA);
      if (random(1, 100) <= rl_red_waage_chance(haus, welt)) then begin
         call rl_red_revolte(haus, welt);
         display_msg(rl_haus_name(h) + ": " + rl_text(160));
      end
   end

   // Der Malamute: Preiskrieg zaehlt nur Wochen mit Ramsch-Preisen; die Beteiligung zahlt
   if ((welt[RL_W_MALAMUTE] == 0) and (welt[RL_W_MALAMUTE_WEG] == RL_MALAMUTE_PREISKRIEG)
       and (haus[rl_idx(h, RL_F_PREISSTUFE)] == RL_PREIS_RAMSCH)) then begin
      welt[RL_W_MALAMUTE_WOCHEN] := welt[RL_W_MALAMUTE_WOCHEN] + 1;
      if (welt[RL_W_MALAMUTE_WOCHEN] >= RL_PREISKRIEG_WOCHEN) then begin
         welt[RL_W_MALAMUTE] := 1;
         display_msg(rl_haus_name(h) + ": " + rl_text(161));
      end
   end
   if (welt[RL_W_MALAMUTE_WEG] == RL_MALAMUTE_BETEILIGUNG) then
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + RL_MALAMUTE_ANTEIL_WOCHE;
end

/* ------------------------------------------------------------------ */
/* Vault City (Umsetzung 9, rl_vaultcity.h)                            */
/* ------------------------------------------------------------------ */
procedure rl_vc_woche(variable woche) begin
   variable h := RL_VAULT_CITY;
   if (not rl_vc_besitz(haus)) then return;
   call rl_vc_schweigegeld(haus, welt);

   // Die Akte: Einfluss waechst, und irgendwann findet sie jemand
   if (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_AKTE) then begin
      call rl_haus_plus(haus, h, RL_F_EINFLUSS, 2);
      if (random(1, 100) <= 3 + haus[rl_idx(h, RL_F_HITZE)] / 10) then begin
         display_msg(rl_haus_name(h) + ": " + rl_text(173));
         call rl_vc_razzia(haus, welt);
         call rl_vc_razzia_meldung;
      end
   end

   // Die angekuendigte Razzia: Wer den Keller geschlossen hat, verliert niemanden
   if ((welt[RL_W_VC_RAZZIA_WOCHE] > 0) and (woche >= welt[RL_W_VC_RAZZIA_WOCHE])) then begin
      welt[RL_W_VC_RAZZIA_WOCHE] := 0;
      if (haus[rl_idx(h, RL_F_GESCHLOSSEN)] > 0) then
         display_msg(rl_haus_name(h) + ": " + rl_text(172));
      else begin
         call rl_vc_razzia(haus, welt);
         call rl_vc_razzia_meldung;
      end
   end
end

// Aus dem Ereigniswurf: angekuendigt (Wache, E >= 60) oder sofort
procedure rl_vc_razzia_kommt begin
   if (welt[RL_W_VC_LYNETTE]) then return;
   if (rl_vc_warnung(haus, welt)) then begin
      if (welt[RL_W_VC_RAZZIA_WOCHE] == 0) then begin
         welt[RL_W_VC_RAZZIA_WOCHE] := rl_woche_jetzt + 1;
         display_msg(rl_haus_name(RL_VAULT_CITY) + ": " + rl_text(171));
      end
      return;
   end
   call rl_vc_razzia(haus, welt);
   call rl_vc_razzia_meldung;
end

procedure rl_vc_razzia_meldung begin
   display_msg(rl_haus_name(RL_VAULT_CITY) + ": " + rl_text(170) + welt[RL_W_VC_GEFASST] + rl_text(174));
end

/* ------------------------------------------------------------------ */
/* NCR (Umsetzung 10, rl_ncr.h)                                        */
/* ------------------------------------------------------------------ */

// Die Lizenz nach der Wartezeit: Die Traenke oeffnet
procedure rl_ncr_lizenz_kommt begin
   if ((welt[RL_W_NCR_LIZENZ_WOCHE] > 0) and (rl_woche_jetzt >= welt[RL_W_NCR_LIZENZ_WOCHE])
       and not rl_ncr_besitz(haus)) then begin
      call rl_ncr_eroeffnen(haus, welt);
      display_msg(rl_haus_name(RL_NCR) + ": " + rl_text(180));
   end
end

procedure rl_ncr_woche(variable woche) begin
   variable h := RL_NCR, il, akt, fertig;
   if (not rl_ncr_besitz(haus)) then return;

   // Lizenz und Auflage: illegal heisst Risiko 1 -> 4
   il := rl_ncr_illegal(haus, welt);
   if (il) then haus[rl_idx(h, RL_F_RISIKO_MOD)] := RL_ILLEGAL_RISIKO;
   else haus[rl_idx(h, RL_F_RISIKO_MOD)] := 0;
   if ((il == 2) and (welt[RL_W_NCR_LEGAL] != 2)) then
      display_msg(rl_haus_name(h) + ": " + rl_text(181));
   else if ((il == 0) and (welt[RL_W_NCR_LEGAL] == 2)) then
      display_msg(rl_haus_name(h) + ": " + rl_text(182));
   welt[RL_W_NCR_LEGAL] := il;

   // Vortis' Leute: Die Rangers finden sie
   if ((haus[rl_idx(h, RL_F_ZWANG)] > 0) and (welt[RL_W_NCR_ENTZOGEN] == 0)
       and (random(1, 100) <= 5 + haus[rl_idx(h, RL_F_HITZE)] / 10)) then begin
      call rl_ncr_rangers_razzia(haus, welt);
      display_msg(rl_haus_name(h) + ": " + rl_text(195));
   end

   // Vortis zahlt Schweigegeld, solange er frei ist
   if ((welt[RL_W_REINE_AKT4] == RL_AKT4_ERPRESST) and (welt[RL_W_VORTIS] != RL_VORTIS_VERHAFTET)) then
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + RL_VORTIS_SCHWEIGEGELD;

   // Die Reinen
   akt := welt[RL_W_REINE];
   if (akt == RL_REINE_OFFEN) then begin
      if ((welt[RL_W_REINE_WOCHE] > 0) and (woche >= welt[RL_W_REINE_WOCHE])) then begin
         welt[RL_W_REINE] := RL_REINE_FLUGBLAETTER;
         welt[RL_W_REINE_WOCHE] := woche;
         welt[RL_W_LIGA] := RL_LIGA_KAMPAGNE;
         display_msg(rl_haus_name(h) + ": " + rl_text(183));
      end
   end else if (akt == RL_REINE_FLUGBLAETTER) then begin
      fertig := ((welt[RL_W_REINE_AKT1] != RL_AKT1_OFFEN) and (welt[RL_W_REINE_AKT1] != RL_AKT1_GESCHICHTE));
      if ((fertig and (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_ABSTAND))
          or (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_FRIST)) then begin
         welt[RL_W_REINE] := RL_REINE_ANHOERUNG;
         welt[RL_W_REINE_WOCHE] := woche;
         display_msg(rl_haus_name(h) + ": " + rl_text(184));
      end
   end else if (akt == RL_REINE_ANHOERUNG) then begin
      fertig := (welt[RL_W_REINE_ANHOERUNG] != RL_ANHOERUNG_OFFEN);
      if ((fertig and (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_ABSTAND))
          or (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_FRIST)) then begin
         if (not fertig) then begin
            welt[RL_W_REINE_ANHOERUNG] := RL_ANHOERUNG_VERLOREN;
            display_msg(rl_haus_name(h) + ": " + rl_text(196));
         end
         welt[RL_W_REINE] := RL_REINE_FEUER;
         welt[RL_W_REINE_WOCHE] := woche;
         welt[RL_W_REINE_BRAND] := RL_BRAND_BRENNT;
         display_msg(rl_haus_name(h) + ": " + rl_text(185));
      end
   end else if (akt == RL_REINE_FEUER) then begin
      // Wer nicht loescht, verliert das Obergeschoss fuer vier Wochen
      if ((welt[RL_W_REINE_BRAND] == RL_BRAND_BRENNT) and (woche >= welt[RL_W_REINE_WOCHE] + 1)) then begin
         welt[RL_W_REINE_BRAND] := RL_BRAND_ABGEBRANNT;
         welt[RL_W_REINE_BRAND_WOCHE] := woche + RL_BRAND_WOCHEN;
         call rl_haus_plus(haus, h, RL_F_MORAL, -10);
         display_msg(rl_haus_name(h) + ": " + rl_text(186));
      end
      // Ohne Beweise geht die Linie zu Ende
      if (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_FRIST) then begin
         call rl_reine_ende(haus, welt);
         call rl_reine_ende_meldung;
      end
   end else if (akt == RL_REINE_BEWEISE) then begin
      if (woche >= welt[RL_W_REINE_WOCHE] + RL_REINE_FRIST) then begin
         call rl_reine_ende(haus, welt);
         call rl_reine_ende_meldung;
      end
   end
end

procedure rl_reine_ende_meldung begin
   variable e := welt[RL_W_REINE], n := 193;
   if (e == RL_REINE_MUSTERHAUS) then n := 188;
   else if (e == RL_REINE_DISKREDITIERUNG) then n := 189;
   else if (e == RL_REINE_VERBOT) then n := 192;
   display_msg(rl_haus_name(RL_NCR) + ": " + rl_text(n));
end

/* ------------------------------------------------------------------ */
/* San Francisco (Umsetzung 11, rl_sanfran.h)                          */
/* ------------------------------------------------------------------ */
procedure rl_sf_woche(variable woche) begin
   variable h := RL_SAN_FRAN, c;
   if (not rl_sf_besitz(haus)) then return;
   // Augen der Shi: Irgendwann merken es die Tanker-Leute
   if ((welt[RL_W_SF_DULDUNG] == RL_DULDUNG_SPITZEL) and (welt[RL_W_SF_SPITZEL_AUF] == 0)) then begin
      c := rl_max(2, 15 - has_skill(dude_obj, SKILL_SNEAK) / 10);
      if (random(1, 100) <= c) then begin
         welt[RL_W_SF_SPITZEL_AUF] := 1;
         call rl_haus_plus(haus, h, RL_F_HITZE, 10);
         display_msg(rl_haus_name(h) + ": " + rl_text(198));
      end
   end
end

/* ------------------------------------------------------------------ */
/* Blut auf der Virgin Street (Umsetzung 12, rl_virgin.h)              */
/* ------------------------------------------------------------------ */
procedure rl_virgin_woche(variable woche) begin
   variable h := RL_NEW_RENO, akt := welt[RL_W_VIRGIN], f := welt[RL_W_VIRGIN_FLAGS];
   if (not rl_nr_besitz(haus)) then return;

   // Die Umarmung reicht bis in jedes neue Haus
   if (akt == RL_VIRGIN_UMARMUNG) then call rl_virgin_umarmung(haus, welt);
   // Nach dem leeren Stuhl: vier Wochen Machtvakuum, dann neue Tribute
   if ((akt == RL_VIRGIN_LEERER_STUHL) and ((f bwand RL_VF_NEU_VERHANDELT) == 0)
       and (woche >= welt[RL_W_VIRGIN_WOCHE] + 4)) then begin
      welt[RL_W_VIRGIN_FLAGS] := f bwor RL_VF_NEU_VERHANDELT;
      display_msg(rl_haus_name(h) + ": " + rl_text(207));
   end
   if (akt >= RL_VIRGIN_UMARMUNG) then return;

   // Vanilla: Die Mordinos fallen, waehrend die Linie laeuft
   if ((akt >= RL_VIRGIN_GEBUEHR) and rl_mordino_weg and ((f bwand RL_VF_RACHE) == 0)) then begin
      call rl_virgin_ende(haus, welt, RL_VIRGIN_LEERER_STUHL);
      display_msg(rl_haus_name(h) + ": " + rl_text(206));
      return;
   end

   if (akt == RL_VIRGIN_OFFEN) then begin
      if (welt[RL_W_VIRGIN_WOCHE] == 0) then
         welt[RL_W_VIRGIN_WOCHE] := woche + RL_VIRGIN_ABSTAND;     // zwei Wochen nach der Uebernahme
      else if (woche >= welt[RL_W_VIRGIN_WOCHE]) then begin
         if (rl_mordino_weg) then begin
            // Venuti fuehrt einen Rest der Familie und will Rache: ab Akt 3
            welt[RL_W_VIRGIN_FLAGS] := f bwor RL_VF_RACHE bwor RL_VF_ENTSCHIEDEN;
            call rl_virgin_weiter(welt, RL_VIRGIN_JET);
            call rl_haus_plus(haus, h, RL_F_MORAL, -10);
            display_msg(rl_haus_name(h) + ": " + rl_text(203));
         end else begin
            call rl_virgin_weiter(welt, RL_VIRGIN_GEBUEHR);
            display_msg(rl_haus_name(h) + ": " + rl_text(200));
         end
      end
   end else if (akt == RL_VIRGIN_GEBUEHR) then begin
      if ((f bwand RL_VF_ENTSCHIEDEN) and (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_ABSTAND)) then begin
         call rl_virgin_weiter(welt, RL_VIRGIN_KITTY);
         display_msg(rl_haus_name(h) + ": " + rl_text(201));
      end else if (((f bwand RL_VF_ENTSCHIEDEN) == 0) and (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_FRIST)) then begin
         // Schweigen ist auch eine Antwort: Venuti nimmt es als Nein
         welt[RL_W_VIRGIN_FLAGS] := f bwor RL_VF_ENTSCHIEDEN;
         call rl_haus_plus(haus, h, RL_F_HITZE, 10);
         call rl_virgin_weiter(welt, RL_VIRGIN_JET);
         call rl_haus_plus(haus, h, RL_F_MORAL, -10);
         display_msg(rl_haus_name(h) + ": " + rl_text(202));
      end
   end else if (akt == RL_VIRGIN_KITTY) then begin
      if (((welt[RL_W_KITTY_WEG] != RL_KITTY_OFFEN) and (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_ABSTAND))
          or (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_FRIST)) then begin
         call rl_virgin_weiter(welt, RL_VIRGIN_JET);
         call rl_haus_plus(haus, h, RL_F_MORAL, -10);
         display_msg(rl_haus_name(h) + ": " + rl_text(203));
      end
   end else if (akt == RL_VIRGIN_JET) then begin
      if (((f bwand RL_VF_DEALER_WEG) and (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_ABSTAND))
          or (woche >= welt[RL_W_VIRGIN_WOCHE] + RL_VIRGIN_FRIST + RL_VIRGIN_ABSTAND)) then begin
         call rl_virgin_weiter(welt, RL_VIRGIN_MESSER);
         display_msg(rl_haus_name(h) + ": " + rl_text(204));
      end
   end else if (akt == RL_VIRGIN_MESSER) then begin
      // Wer das Ultimatum liegen laesst, dem verwuesten sie das Haus (Module fallen 2 Wochen aus)
      if ((haus[rl_idx(h, RL_F_ANGRIFF)] == RL_ANGRIFF_KEINER)
          and (woche >= rl_max(welt[RL_W_VIRGIN_WOCHE], welt[RL_W_VIRGIN_NACHT]) + RL_VIRGIN_FRIST)) then begin
         welt[RL_W_VIRGIN_NACHT] := woche;
         haus[rl_idx(h, RL_F_GESCHLOSSEN)] := rl_max(haus[rl_idx(h, RL_F_GESCHLOSSEN)], 2);
         call rl_haus_plus(haus, h, RL_F_MORAL, -10);
         display_msg(rl_haus_name(h) + ": " + rl_text(205));
      end
   end
end

/* Kitty als Rivalin wirbt jeden Monat eine Person aus jedem Haus mit Moral < 60 ab
   (Phase 4, 3.6); mit dem Titel "Anstaendiges Haus" nur jeden zweiten Monat. */
procedure rl_kitty_woche(variable woche) begin
   variable h := 0, abstand := RL_ABWERBUNG_WOCHEN;
   if (not welt[RL_W_KITTY_RIVALIN]) then return;
   if (global_var(GVAR_RL_TITEL_ANSTAND)) then abstand := abstand * 2;
   if (woche < welt[RL_W_KITTY_ABWERBUNG] + abstand) then return;
   welt[RL_W_KITTY_ABWERBUNG] := woche;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if (haus[rl_idx(h, RL_F_BESITZ)] and (haus[rl_idx(h, RL_F_MORAL)] < 60)) then begin
         // Ein Angebot, auf das die Madame reagieren kann (Phase 4, 4.3); in einer Krise geht die Person sofort
         if (rl_krise_setzen(haus, h, RL_EV_ABWERBUNG)) then
            display_msg(rl_haus_name(h) + ": " + rl_text(234));
         else if (rl_personal_verlust(haus, h, RL_VERLUST_ABGANG) >= 0) then
            display_msg(rl_haus_name(h) + ": " + rl_text(208));
      end
      h := h + 1;
   end
end

/* ------------------------------------------------------------------ */
/* Talente (Umsetzung 13, rl_talente.h)                                */
/* ------------------------------------------------------------------ */

// Reiseziele: Vesper wartet in Gecko, Talus sitzt in Broken Hills
procedure rl_talente_reise begin
   variable k := cur_map_index;
   if (welt == 0) then welt := rl_lade_welt;
   if ((welt[RL_W_VESPER_STAND] == RL_TS_AUFTRAG) and (k >= MAP_GECKO_SETTLEMENT) and (k <= MAP_GECKO_ACCESS_TUNNELS)) then begin
      welt[RL_W_VESPER_STAND] := RL_TS_UNTERWEGS;
      display_msg(rl_text(210));
   end
   if ((welt[RL_W_TALUS] == RL_TS_AUFTRAG) and ((k == MAP_BROKEN_HILLS1) or (k == MAP_BROKEN_HILLS2))) then begin
      if (welt[RL_W_TALUS_WEG] == RL_TALUS_AUSBRUCH) then begin
         welt[RL_W_TALUS] := RL_TS_UNTERWEGS;
         welt[RL_W_MARCUS] := RL_MARCUS_GESPERRT;
         display_msg(rl_text(215));
      end else if (global_var(GVAR_BH_MISSING) >= MISSING_FINISHED_CASH) then begin
         welt[RL_W_TALUS] := RL_TS_UNTERWEGS;
         display_msg(rl_text(214));
      end else
         display_msg(rl_text(216));
   end
end

procedure rl_talent_weg(variable wer, variable text) begin
   call rl_talent_anwenden(haus, welt, wer, -1);
   display_msg(rl_text(text));
end

procedure rl_talente_woche(variable woche) begin
   variable h, jet := 0, doc := 0, c;

   // Vesper: kommt an, singt ab Bar II, geht bei Zwangspersonal oder ohne Loyalitaet
   if ((welt[RL_W_VESPER_STAND] == RL_TS_UNTERWEGS) or (welt[RL_W_VESPER_STAND] == RL_TS_WARTET)) then begin
      if (rl_nr_besitz(haus) and rl_bar2_steht(haus)) then begin
         welt[RL_W_VESPER_STAND] := RL_TS_DA;
         welt[RL_W_VESPER] := 1;
         call rl_talent_anwenden(haus, welt, RL_TALENT_VESPER, 1);
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(211));
      end else if (welt[RL_W_VESPER_STAND] == RL_TS_UNTERWEGS) then begin
         welt[RL_W_VESPER_STAND] := RL_TS_WARTET;
         display_msg(rl_haus_name(RL_NEW_RENO) + ": " + rl_text(212));
      end
   end else if (welt[RL_W_VESPER_STAND] == RL_TS_DA) then begin
      if (rl_zwang_irgendwo(haus) or (welt[RL_W_VESPER_LOYAL] < RL_LOYAL_GRENZE)) then begin
         welt[RL_W_VESPER_STAND] := RL_TS_GEGANGEN;
         welt[RL_W_VESPER] := 0;
         call rl_talent_weg(RL_TALENT_VESPER, 213);
      end
   end

   // Abigail: Erpresst verraet sie irgendwann (5 % je Woche)
   if ((welt[RL_W_ABIGAIL] == RL_TS_DA) and (welt[RL_W_ABIGAIL_WEG] == RL_ABIGAIL_ERPRESST)
       and (random(1, 100) <= 5)) then begin
      welt[RL_W_ABIGAIL] := RL_TS_GEGANGEN;
      call rl_talent_weg(RL_TALENT_ABIGAIL, 222);
      if (rl_vc_besitz(haus)) then begin
         call rl_vc_razzia(haus, welt);
         call rl_vc_razzia_meldung;
      end
   end

   // Talus: kommt an; geht, sobald in seinem Haus jemand hinter einem Riegel sitzt
   if (welt[RL_W_TALUS] == RL_TS_UNTERWEGS) then begin
      h := rl_max(0, welt[RL_W_TALUS_HAUS] - 1);
      if (haus[rl_idx(h, RL_F_BESITZ)] and (welt[RL_W_TALUS_HAUS] > 0)) then begin
         welt[RL_W_TALUS] := RL_TS_DA;
         call rl_talent_anwenden(haus, welt, RL_TALENT_TALUS, 1);
         display_msg(rl_haus_name(h) + ": " + rl_text(217));
      end
   end else if (welt[RL_W_TALUS] == RL_TS_DA) then begin
      h := welt[RL_W_TALUS_HAUS] - 1;
      if ((haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_RIEGEL_AUSSEN) or (haus[rl_idx(h, RL_F_ZWANG)] > 0)) then begin
         welt[RL_W_TALUS] := RL_TS_GEGANGEN;
         welt[RL_W_MARCUS] := RL_MARCUS_GESPERRT;
         call rl_talent_weg(RL_TALENT_TALUS, 218);
      end
   end

   // Julian: VIP-Kundschaft in jedem Haus mit VIP-Trakt, Ruf +1; der Rueckfall
   h := 0;
   while (h < RL_ANZAHL_HAEUSER) do begin
      if (rl_julian_aktiv(welt)) then haus[rl_idx(h, RL_F_VIP_MOD)] := RL_JULIAN_VIP;
      else haus[rl_idx(h, RL_F_VIP_MOD)] := 0;
      if (haus[rl_idx(h, RL_F_BESITZ)]) then begin
         if (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_JET_THEKE) then jet := 1;
         if (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_KRANKENSTUBE) then doc := 1;
         if (rl_julian_aktiv(welt) and (haus[rl_idx(h, RL_F_MODULE)] bwand RL_MOD_VIP)) then
            call rl_haus_plus(haus, h, RL_F_RUF, 1);
      end
      h := h + 1;
   end
   // Eine Woche im Sterben: Hat ihn niemand gerettet und steht keine Krankenstube, stirbt er
   if (welt[RL_W_JULIAN] == RL_TS_KRITISCH) then begin
      if (doc) then begin
         welt[RL_W_JULIAN] := RL_TS_DA;
         welt[RL_W_JULIAN_LOYAL] := welt[RL_W_JULIAN_LOYAL] - 20;
         display_msg(rl_text(221));
      end else begin
         welt[RL_W_JULIAN] := RL_TS_TOT;
         display_msg(rl_text(220));
      end
   end else if (rl_julian_aktiv(welt) and (welt[RL_W_JULIAN_WEG] != RL_JULIAN_TYRANN)) then begin
      c := 3;
      if (jet) then c := 10;
      if (welt[RL_W_JULIAN] == RL_TS_AUFTRAG) then c := c * 2;      // noch nicht vom Jet
      if (random(1, 100) <= c) then begin
         if (doc) then begin
            welt[RL_W_JULIAN_LOYAL] := welt[RL_W_JULIAN_LOYAL] - 10;
            display_msg(rl_text(219));
         end else begin
            welt[RL_W_JULIAN] := RL_TS_KRITISCH;
            display_msg(rl_text(224));
         end
      end
      if (rl_julian_aktiv(welt) and (welt[RL_W_JULIAN_LOYAL] < RL_LOYAL_GRENZE)) then begin
         welt[RL_W_JULIAN] := RL_TS_GEGANGEN;
         display_msg(rl_text(223));
      end
   end
end

/* ------------------------------------------------------------------ */
/* Jobs und Laeuferroute (Umsetzung 14, rl_jobs.h)                     */
/* ------------------------------------------------------------------ */

// Marcus kann man nur sprechen, wenn man in Broken Hills war
procedure rl_jobs_reise begin
   variable k := cur_map_index;
   if (welt == 0) then welt := rl_lade_welt;
   if ((k == MAP_BROKEN_HILLS1) or (k == MAP_BROKEN_HILLS2)) then
      welt[RL_W_JOBS] := welt[RL_W_JOBS] bwor RL_JOB_BH_BESUCHT;
end

/* Bestechung und Schutzgeld jede Woche. Rueckgabe 1: Es wurde Schutzgeld
   kassiert (zaehlt als Tyrannen-Woche). */
procedure rl_jobs_woche begin
   variable h := 0, bit, schutz := 0;

   // Tyler: Das Schmiergeld endet, wenn Tyler faellt oder die Gosse nicht mehr uns gehoert
   if (welt[RL_W_JOBS] bwand RL_JOB_TYLER) then begin
      if (tyler_dead or (welt[RL_W_TYLER] == RL_TYLER_BESIEGT) or (welt[RL_W_TYLER] == RL_TYLER_TOT)
          or (haus[rl_idx(RL_DEN, RL_F_BESITZ)] == 0)) then begin
         call rl_job_bestechung(haus, welt, RL_JOB_TYLER, 0);
         display_msg(rl_haus_name(RL_DEN) + ": " + rl_text(230));
      end else
         call rl_haus_plus(haus, RL_DEN, RL_F_HITZE, -5);
   end
   // Der Polizist in Downtown: H -5, die Rangers bleiben unberuehrt
   if (welt[RL_W_JOBS] bwand RL_JOB_POLIZEI) then begin
      if (haus[rl_idx(RL_NCR, RL_F_BESITZ)] == 0) then
         call rl_job_bestechung(haus, welt, RL_JOB_POLIZEI, 0);
      else
         call rl_haus_plus(haus, RL_NCR, RL_F_HITZE, -5);
   end
   // Schutzgeld: 50-150 $ in die Kasse, E +2, H +5 (NCR: doppelt, die Rangers), K -2
   while (h < RL_ANZAHL_HAEUSER) do begin
      bit := rl_schutz_bit(h);
      if (bit and (welt[RL_W_JOBS] bwand bit)) then begin
         if (haus[rl_idx(h, RL_F_BESITZ)] == 0) then
            welt[RL_W_JOBS] := welt[RL_W_JOBS] - bit;
         else begin
            haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] + random(50, 150);
            call rl_haus_plus(haus, h, RL_F_EINFLUSS, 2);
            if (h == RL_NCR) then call rl_haus_plus(haus, h, RL_F_HITZE, 10);
            else call rl_haus_plus(haus, h, RL_F_HITZE, 5);
            rl_karma(-2);
            schutz := 1;
         end
      end
      h := h + 1;
   end
   return schutz;
end

/* ------------------------------------------------------------------ */
/* Ereignisse vollstaendig (Umsetzung 15, rl_ereignisse.h)             */
/* ------------------------------------------------------------------ */

/* Eine Woche Krise: Die angekuendigte Razzia kommt, Sucht wird zur
   Ueberdosis, nach drei Wochen eskaliert die Krise je nach Art (Phase 4, 4.1). */
procedure rl_krise_woche(variable h) begin
   variable k := haus[rl_idx(h, RL_F_KRISE)], w;
   w := haus[rl_idx(h, RL_F_KRISENWOCHEN)] + 1;
   haus[rl_idx(h, RL_F_KRISENWOCHEN)] := w;

   if ((k == RL_EV_RAZZIA) and rl_razzia_stadt(h)) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      haus[rl_idx(h, RL_F_KRISENWOCHEN)] := 0;
      display_msg(rl_haus_name(h) + ": " + rl_text(rl_razzia_ausfuehren(haus, welt, h)));
      return;
   end
   // Sucht ohne Behandlung: ab der zweiten Woche jede Woche 25 % Ueberdosis
   if ((k == RL_EV_STOFF) and (w >= 2)) then begin
      if (random(1, 100) <= 25) then begin
         call rl_tod_im_haus(haus, welt, h, 0, 0);
         display_msg(rl_haus_name(h) + ": " + rl_text(240));
         return;
      end
   end
   if (w != 3) then return;

   if ((k == RL_EV_SOLDATEN) or (k == RL_EV_FREIER)) then begin
      // Eine Person aus dem Personal stirbt: Moral -20, Ruf -10
      call rl_tod_im_haus(haus, welt, h, 1, 0);
      call rl_haus_plus(haus, h, RL_F_MORAL, -10);
      call rl_haus_plus(haus, h, RL_F_RUF, -10);
      display_msg(rl_haus_name(h) + ": " + rl_text(241));
   end else if (k == RL_EV_SEUCHE) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      haus[rl_idx(h, RL_F_GESCHLOSSEN)] := rl_max(haus[rl_idx(h, RL_F_GESCHLOSSEN)], 2);
      call rl_haus_plus(haus, h, RL_F_MORAL, -10);
      display_msg(rl_haus_name(h) + ": " + rl_text(242));
   end else if (k == RL_EV_KASSE) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      haus[rl_idx(h, RL_F_KASSE)] := haus[rl_idx(h, RL_F_KASSE)] - 300;
      display_msg(rl_haus_name(h) + ": " + rl_text(243));
   end else if (k == RL_EV_FLUCHT) then begin
      if (haus[rl_idx(h, RL_F_ZWANG)] > 0) then begin
         call rl_tod_im_haus(haus, welt, h, 0, 1);            // auf der Flucht gestorben
         display_msg(rl_haus_name(h) + ": " + rl_text(244));
      end else begin
         haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
         call rl_personal_verlust(haus, h, RL_VERLUST_ABGANG);
         display_msg(rl_haus_name(h) + ": " + rl_text(245));
      end
   end else if (k == RL_EV_TOD) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      call rl_haus_plus(haus, h, RL_F_MORAL, -15);
      display_msg(rl_haus_name(h) + ": " + rl_text(246));
   end else if (k == RL_EV_STAMMKUNDE) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;              // die Gelegenheit ist vorbei
   end else if (k == RL_EV_ABWERBUNG) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      call rl_personal_verlust(haus, h, RL_VERLUST_ABGANG);
      display_msg(rl_haus_name(h) + ": " + rl_text(208));
   end else if (k == RL_EV_UEBERFALL) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      welt[RL_W_UEBERFALL_BETRAG] := 0;
      display_msg(rl_haus_name(h) + ": " + rl_text(247));
   end else if (k == RL_EV_GHUL) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      welt[RL_W_VESPER_LOYAL] := welt[RL_W_VESPER_LOYAL] - 20;
      display_msg(rl_haus_name(h) + ": " + rl_text(248));
   end else if (k == RL_EV_RICHTER) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      welt[RL_W_ABIGAIL_LOYAL] := welt[RL_W_ABIGAIL_LOYAL] - 10;
      call rl_haus_plus(haus, h, RL_F_HITZE, 10);
      display_msg(rl_haus_name(h) + ": " + rl_text(249));
   end else if (k == RL_EV_BUNKER) then begin
      haus[rl_idx(h, RL_F_KRISE)] := RL_EV_KEINS;
      haus[rl_idx(h, RL_F_SICHERHEIT)] := rl_max(0, haus[rl_idx(h, RL_F_SICHERHEIT)] - RL_DESERTEUR_SICHERHEIT);
      welt[RL_W_DESERTEUR] := 0;
      display_msg(rl_haus_name(h) + ": " + rl_text(239));
   end else begin
      // Metzgers Vergeltung und die uebrigen: Moral -10, Ruf -10, die Krise bleibt
      call rl_haus_plus(haus, h, RL_F_MORAL, -10);
      call rl_haus_plus(haus, h, RL_F_RUF, -10);
      display_msg(rl_haus_name(h) + ": " + rl_text(111));
   end
   if (haus[rl_idx(h, RL_F_KRISE)] == RL_EV_KEINS) then haus[rl_idx(h, RL_F_KRISENWOCHEN)] := 0;
end

// Die bezahlten Soldaten kommen vielleicht wieder; der Deserteur geht mit seinem Haus
procedure rl_ereignisse_woche(variable woche) begin
   variable h := welt[RL_W_SOLDATEN_HAUS] - 1;
   if ((h >= 0) and (woche >= welt[RL_W_SOLDATEN_WOCHE])) then begin
      welt[RL_W_SOLDATEN_HAUS] := 0;
      if (haus[rl_idx(h, RL_F_BESITZ)] and rl_krise_setzen(haus, h, RL_EV_SOLDATEN)) then
         display_msg(rl_haus_name(h) + ": " + rl_text(238));
   end
   h := welt[RL_W_DESERTEUR] - 1;
   if (h >= 0) then begin                        // SSL wertet "and" immer ganz aus
      if (haus[rl_idx(h, RL_F_BESITZ)] == 0) then welt[RL_W_DESERTEUR] := 0;
   end
end

#ifdef RL_DEBUG
/* Debug-Tasten:
     F9   Essie und Kolbe erscheinen neben dem Spieler, damit sich der Prolog
          auch ohne die Innenkarte RLDEN01 testen laesst. Figuren wie in
          RLDEN01: Durchschnittsbaeuerin und Schlaeger aus Vanilla.
     F11  direkt in die Gosse (Pruefliste der Karten)
     F8   auf Den Business 2 neben die Kellertreppe (Pruefliste der Karten) */
procedure rl_taste begin
   variable gedrueckt := get_sfall_arg;
   variable taste := get_sfall_arg;
   if (not gedrueckt) then return;
   if (taste == RL_TASTE_SPAWN) then
      call rl_debug_spawn;
   else if (taste == RL_TASTE_GOSSE) then
      load_map(RL_KARTE_GOSSE, 0);
   else if ((taste == RL_TASTE_TREPPE) and (cur_map_index == MAP_DEN_BUSINESS)) then
      move_to(dude_obj, RL_GOSSE_ANKUNFT_HEX, RL_GOSSE_TREPPE_EBENE);
end

procedure rl_debug_spawn begin
   variable obj;
   obj := create_object_sid(PID_AVERAGE_PEASANT_FEMALE, tile_num_in_direction(dude_tile, 0, 2), dude_elevation, SCRIPT_RLESSIE);
   obj := create_object_sid(PID_TOUGH_THUG_MALE, tile_num_in_direction(dude_tile, 1, 3), dude_elevation, SCRIPT_RLKOLBE);
   display_msg(rl_text(190));
end
#endif

procedure rl_haus_name(variable h) begin
   return rl_text(100 + h);
end

// Spieltexte stehen in text/<sprache>/game/rotlicht.msg, nicht im Code
procedure rl_text(variable n) begin
   if (rl_texte <= 0) then rl_texte := add_extra_msg_file(RL_TEXTDATEI);
   return message_str_game(rl_texte, n);
end

/* Selbsttest: rechnet das Beispielhaus aus Phase 1 (New Reno, mittlerer
   Ausbau) 30 Wochen lang mit allen drei Anteilsstufen. Die Ausgabe muss
   mit "python3 tools/economy_sim.py --vektoren" uebereinstimmen. */
procedure rl_selbsttest begin
   variable stufe, woche, gewinn, t := RL_TESTHAUS;

   stufe := 0;
   while (stufe <= RL_ANTEIL_FAIR) do begin
      haus[rl_idx(t, RL_F_BESITZ)]      := 0;
      haus[rl_idx(t, RL_F_ZIMMER)]      := 99;
      haus[rl_idx(t, RL_F_PERSONAL)]    := 99;
      haus[rl_idx(t, RL_F_QUALI)]       := 60;
      haus[rl_idx(t, RL_F_MORAL)]       := 50;
      haus[rl_idx(t, RL_F_RUF)]         := 55;
      haus[rl_idx(t, RL_F_AUSSTATTUNG)] := 50;
      haus[rl_idx(t, RL_F_SICHERHEIT)]  := 70;
      haus[rl_idx(t, RL_F_HITZE)]       := 0;
      haus[rl_idx(t, RL_F_PREISSTUFE)]  := RL_PREIS_STANDARD;
      haus[rl_idx(t, RL_F_ANTEIL)]      := stufe;
      haus[rl_idx(t, RL_F_BAR)]         := 1;
      haus[rl_idx(t, RL_F_NEBEN)]       := 0;
      haus[rl_idx(t, RL_F_MODULE)]      := RL_MOD_KONTOR;
      haus[rl_idx(t, RL_F_STUFEN)]      := 4;
      haus[rl_idx(t, RL_F_LOEHNE)]      := 310;
      haus[rl_idx(t, RL_F_MORALBONUS)]  := 0;
      haus[rl_idx(t, RL_F_STADTMOD)]    := 0;
      haus[rl_idx(t, RL_F_TRIBUTMOD)]   := 0;
      haus[rl_idx(t, RL_F_KRISE)]       := RL_EV_KEINS;
      haus[rl_idx(t, RL_F_ZWANG)]       := 0;
      woche := 1;
      while (woche <= 30) do begin
         gewinn := rl_rechne_woche(haus, t, t);
         debug_msg("RLTEST " + stufe + " W" + woche + " " + gewinn);
         woche := woche + 1;
      end
      stufe := stufe + 1;
   end
   display_msg(rl_text(191));
end
