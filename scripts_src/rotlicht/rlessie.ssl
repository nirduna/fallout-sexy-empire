/*
   rlessie.ssl - Madame Esther "Essie" Kowalski, die Gosse (The Den)

   Umsetzung 1:
     - Prolog "Essies Schulden": Einstieg, Stand der Schulden, Reaktion auf
       den Weg, den der Spieler mit Kolbe gewaehlt hat (rl_prolog.h)
     - danach Managerin der Gosse mit den gemeinsamen Knoten (rl_manager.h):
       Bericht, Kasse, Preise, Anteil, Moral, Krisen, Ausbau
     - wurde sie an Metzger ausgeliefert, verschwindet sie

   Texte: text_src/german/dialog/rlessie.msg
*/

#define SCRIPT_REALNAME "rlessie"
#include "define.h"
#include "../headers/rotlicht.h"

#define NAME                    SCRIPT_RLESSIE
#include "command.h"
#include "../headers/rl_prolog.h"

procedure start;
procedure talk_p_proc;
procedure critter_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;

procedure Node300;      // erste Begegnung: die Schulden
procedure Node301;      // wie viel?
procedure Node302;      // der Spieler uebernimmt
procedure Node310;      // Prolog laeuft
procedure Node320;      // Reaktion auf den Weg (einmalig)
procedure Node391;      // nur mit RL_DEBUG: Prolog ueberspringen
procedure Node999;

variable haus;
variable welt;
variable h := RL_DEN;

#include "../headers/rl_manager.h"

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_mstr(200);
end

procedure description_p_proc begin
   script_overrides;
   display_mstr(201);
end

// Wurde Essie an Metzger ausgeliefert, ist sie weg
procedure critter_p_proc begin
   if (welt == 0) then welt := rl_lade_welt;
   if (welt[RL_W_ESSIE] == RL_ESSIE_AUSGELIEFERT) then
      destroy_object(self_obj);
end

procedure talk_p_proc begin
   haus := rl_lade_haeuser;
   welt := rl_lade_welt;
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (welt[RL_W_PROLOG] == RL_PROLOG_OFFEN) then
         call Node300;
      else if (welt[RL_W_PROLOG] == RL_PROLOG_LAEUFT) then
         call Node310;
      else if (welt[RL_W_ESSIE_REAKTION] == 0) then
         call Node320;
      else
         call RLM_Start;
   gSay_End;
   end_dialogue;
   RLM_NACH_DIALOG
end

procedure Node300 begin
   Reply(mstr(300) + " " + mstr(301));
   NOption(302, Node301, 004);
   NOption(304, Node302, 004);
   NOption(306, Node999, 004);
#ifdef RL_DEBUG
   NOption(192, Node391, 001);
#endif
   NLowOption(306, Node999);
end

procedure Node301 begin
   Reply(303);
   NOption(304, Node302, 004);
   NOption(306, Node999, 004);
end

procedure Node302 begin
   call rl_prolog_starten(welt);
   Reply(305);
   NOption(307, Node999, 004);
end

procedure Node310 begin
   Reply(mstr(310) + rl_aktuelle_schulden(welt) + mstr(311));
   NOption(312, Node999, 004);
#ifdef RL_DEBUG
   NOption(192, Node391, 001);
#endif
   NLowOption(312, Node999);
end

// Essies Haltung haengt am Weg, den der Spieler mit Kolbe gegangen ist (Phase 3, 2.1)
procedure Node320 begin
   welt[RL_W_ESSIE_REAKTION] := 1;
   Reply(330 + welt[RL_W_PROLOG_WEG]);
   NOption(123, RLM_Start, 004);
   NOption(124, Node999, 004);
end

procedure Node391 begin
   call rl_prolog_starten(welt);
   call rl_prolog_abschliessen(haus, welt, RL_WEG_BEZAHLT);
   Reply(193);
   NOption(123, RLM_Start, 001);
end

procedure Node999 begin
end
