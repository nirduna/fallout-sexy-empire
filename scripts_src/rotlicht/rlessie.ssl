/*
   rlessie.ssl - Madame Esther "Essie" Kowalski, die Gosse (The Den)

   Umsetzung 1:
     - Prolog "Essies Schulden": Einstieg, Stand der Schulden, Reaktion auf
       den Weg, den der Spieler mit Kolbe gewaehlt hat (rl_prolog.h)
     - danach Managerin der Gosse mit den gemeinsamen Knoten (rl_manager.h):
       Bericht, Kasse, Preise, Anteil, Moral, Krisen, Ausbau
     - wurde sie an Metzger ausgeliefert, verschwindet sie
   Umsetzung 5 (Ketten, Akt 2-5):
     - zeigt Mara im Keller, warnt vor Metzgers Durchsuchung
     - kuendigt, wenn der Spieler Mara ausliefert (Fluchtzweig)
     - Akt 5 im Fluchtzweig: Sturm auf die Gilde oder der stille Krieg

   Texte: text_src/english/dialog/rlessie.msg
*/

#define SCRIPT_REALNAME "rlessie"
#include "define.h"
#include "../headers/rotlicht.h"

#define NAME                    SCRIPT_RLESSIE
#include "command.h"
#include "../headers/rl_prolog.h"

procedure start;
procedure talk_p_proc;
procedure critter_p_proc;
procedure map_enter_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;

procedure Node300;      // erste Begegnung: die Schulden
procedure Node301;      // wie viel?
procedure Node302;      // der Spieler uebernimmt
procedure Node310;      // Prolog laeuft
procedure Node320;      // Reaktion auf den Weg (einmalig)
procedure Node340;      // Reaktion auf Metzgers Angebot, Ketten Akt 1 (einmalig)
procedure Node391;      // nur mit RL_DEBUG: Prolog ueberspringen
procedure Node800;      // Ketten, Akt 2: das Maedchen im Keller
procedure Node801;
procedure Node810;      // Essie kuendigt (Mara ausgeliefert)
procedure Node820;      // Metzgers Leute suchen: die Zuflucht bauen
procedure Node830;      // Akt 5 im Fluchtzweig: die Entscheidung
procedure Node831;      // Sturm
procedure Node832;      // stiller Krieg
procedure Node835;      // Sturm angesagt: Erinnerung
procedure Node999;

variable haus;
variable welt;
variable h := RL_DEN;
variable gehen := 0;

#include "../headers/rl_manager.h"

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_mstr(200);
end

procedure description_p_proc begin
   script_overrides;
   display_mstr(201);
end

// Wurde Essie an Metzger ausgeliefert, ist sie weg
procedure critter_p_proc begin
   if (welt == 0) then welt := rl_lade_welt;
   if (welt[RL_W_ESSIE] == RL_ESSIE_AUSGELIEFERT) then
      destroy_object(self_obj);
end

// Hat sie gekuendigt, ist sie beim naechsten Betreten der Gosse fort
procedure map_enter_p_proc begin
   welt := rl_lade_welt;
   if (welt[RL_W_ESSIE] == RL_ESSIE_GEKUENDIGT) then
      destroy_object(self_obj);
end

procedure talk_p_proc begin
   haus := rl_lade_haeuser;
   welt := rl_lade_welt;
   // Ausgeliefert: Metzgers Leute holen sie sofort; kein Gespraech mehr
   if (welt[RL_W_ESSIE] == RL_ESSIE_AUSGELIEFERT) then begin
      destroy_object(self_obj);
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (welt[RL_W_ESSIE] == RL_ESSIE_GEKUENDIGT) then
         call Node810;
      else if (welt[RL_W_PROLOG] == RL_PROLOG_OFFEN) then
         call Node300;
      else if (welt[RL_W_PROLOG] == RL_PROLOG_LAEUFT) then
         call Node310;
      else if (welt[RL_W_ESSIE_REAKTION] == 0) then
         call Node320;
      else if (welt[RL_W_KETTEN_REAKTION] == 1) then
         call Node340;
      else if ((welt[RL_W_MARA_WEG] == RL_MARA_KELLER) and (welt[RL_W_MARA_GESEHEN] == 0)) then
         call Node800;
      else if ((welt[RL_W_MARA_WEG] == RL_MARA_VERSTECKT) and (welt[RL_W_SUCHE] > 0)
               and ((haus[rl_idx(RL_DEN, RL_F_MODULE)] bwand RL_MOD_ZUFLUCHT) == 0)) then
         call Node820;
      else if ((welt[RL_W_KETTEN] == RL_KETTEN_WAHL) and (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_FLUCHT)) then
         call Node830;
      else if (welt[RL_W_KETTEN] == RL_KETTEN_STURM) then
         call Node835;
      else
         call RLM_Start;
   gSay_End;
   end_dialogue;
   RLM_NACH_DIALOG
   if (gehen) then begin
      gehen := 0;
      destroy_object(self_obj);
   end
end

procedure Node300 begin
   Reply(mstr(300) + " " + mstr(301));
   NOption(302, Node301, 004);
   NOption(304, Node302, 004);
   NOption(306, Node999, 004);
#ifdef RL_DEBUG
   NOption(192, Node391, 001);
#endif
   NLowOption(306, Node999);
end

procedure Node301 begin
   Reply(303);
   NOption(304, Node302, 004);
   NOption(306, Node999, 004);
end

procedure Node302 begin
   call rl_prolog_starten(welt);
   Reply(305);
   NOption(307, Node999, 004);
end

procedure Node310 begin
   Reply(mstr(310) + rl_aktuelle_schulden(welt) + mstr(311));
   NOption(312, Node999, 004);
#ifdef RL_DEBUG
   NOption(192, Node391, 001);
#endif
   NLowOption(312, Node999);
end

// Essies Haltung haengt am Weg, den der Spieler mit Kolbe gegangen ist (Phase 3, 2.1)
procedure Node320 begin
   welt[RL_W_ESSIE_REAKTION] := 1;
   Reply(330 + welt[RL_W_PROLOG_WEG]);
   NOption(123, RLM_Start, 004);
   NOption(124, Node999, 004);
end

procedure Node391 begin
   call rl_prolog_starten(welt);
   call rl_prolog_abschliessen(haus, welt, RL_WEG_BEZAHLT);
   Reply(193);
   NOption(123, RLM_Start, 001);
end

// Ketten, Akt 1: Essie hat mitbekommen, was der Spieler Metzger geantwortet hat
procedure Node340 begin
   welt[RL_W_KETTEN_REAKTION] := 2;
   if (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) then
      Reply(350);
   else
      Reply(351);
   NOption(352, RLM_Start, 004);
   NLowOption(352, RLM_Start);
end

/* ------------------------------------------------------------------ */
/* Ketten, Akt 2-5 (Umsetzung 5)                                       */
/* ------------------------------------------------------------------ */
procedure Node800 begin
   welt[RL_W_MARA_GESEHEN] := 1;
   Reply(800);
   NOption(801, Node801, 004);
   NOption(123, RLM_Start, 004);
   NLowOption(801, Node801);
end

procedure Node801 begin
   Reply(802);
   NOption(803, Node999, 004);
   NOption(123, RLM_Start, 004);
   NLowOption(803, Node999);
end

// Mara ausgeliefert: Essie geht (nicht im Tyrannen-Zweig, dort ist sie laengst gebrochen)
procedure Node810 begin
   gehen := 1;
   Reply(810);
   NOption(811, Node999, 004);
   NLowOption(811, Node999);
end

procedure Node820 begin
   Reply(820);
   NOption(821, RLM_Ausbau, 004);
   NOption(123, RLM_Start, 004);
   NLowOption(123, RLM_Start);
end

procedure Node830 begin
   Reply(830);
   GOption(831, Node831, 004);
   NOption(832, Node832, 004);
   NOption(833, RLM_Start, 004);
   NLowOption(833, RLM_Start);
end

procedure Node831 begin
   welt[RL_W_KETTEN] := RL_KETTEN_STURM;
   welt[RL_W_KETTEN_WOCHE] := rl_woche_jetzt;
   Reply(834);
   NOption(123, RLM_Start, 004);
   NOption(124, Node999, 004);
   NLowOption(124, Node999);
end

procedure Node832 begin
   call rl_ketten_ende(haus, welt, RL_KETTEN_STILLER_KRIEG);
   Reply(836);
   NOption(123, RLM_Start, 004);
   NOption(124, Node999, 004);
   NLowOption(124, Node999);
end

procedure Node835 begin
   Reply(835);
   NOption(123, RLM_Start, 004);
   NOption(124, Node999, 004);
   NLowOption(124, Node999);
end

procedure Node999 begin
end
