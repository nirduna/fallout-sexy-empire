/*
   rlden01.ssl - Kartenskript der Gosse (Innenkarte RLDEN01)

   Umsetzung 2:
     - Kellerlicht wie in den Vanilla-Kellern der Den
     - beim ersten Besuch ein Satz zur Stimmung
   Umsetzung 4:
     - Steht Metzgers Angebot (Ketten, Akt 1) noch aus und hat Kolbe die Gosse
       schon verlassen (Spielstand aus einer frueheren Fassung), kommt er zurueck.
   Umsetzung 5:
     - Figuren nach dem Stand von "Ketten": Kolbe (rl_kolbe_bleibt), Mara
       (rl_mara_da), Deke (Akt 4, Fluchtzweig), Jess (Akt 4, Tyrannen-Zweig).
   Spaeter (Phase 2): Ausbauten nach RL_F_MODULE und RL_F_KLASSE sichtbar
   schalten.

   Die Karte selbst baut tools/bau_karten.py aus Beckys Keller (denbus1).

   Texte: text_src/english/dialog/rlden01.msg
*/

#define SCRIPT_REALNAME "rlden01"
#include "define.h"
#include "../headers/rotlicht.h"

#define NAME                    SCRIPT_RLDEN01
#include "command.h"
#include "updatmap.h"

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;

procedure start begin
end

procedure map_enter_p_proc begin
   variable welt;
   if (map_first_run) then
      display_mstr(100);
   Basement_Lighting;

   welt := rl_lade_welt;
   if ((welt[RL_W_PROLOG] == RL_PROLOG_FERTIG) and rl_kolbe_bleibt(welt)) then
      call rl_figur(PID_TOUGH_THUG_MALE, RL_GOSSE_KOLBE_HEX, SCRIPT_RLKOLBE);
   if (rl_mara_da(welt)) then
      call rl_figur(PID_GENERIC_SLAVE_FEMALE, RL_GOSSE_MARA_HEX, SCRIPT_RLMARA);
   if (rl_deke_bleibt(welt) and (welt[RL_W_TYLER] == RL_TYLER_OFFEN)) then
      call rl_figur(PID_TOUGH_THUG_MALE, RL_GOSSE_DEKE_HEX, SCRIPT_RLDEKE);
   if (rl_jess_bleibt(welt) and (welt[RL_W_LARA] == RL_LARA_OFFEN)) then
      call rl_figur(PID_TOUGH_THUG_FEMALE, RL_GOSSE_DEKE_HEX, SCRIPT_RLJESS);
end

procedure map_update_p_proc begin
   Basement_Lighting;
end
