/*
   rlkolbe.ssl - Kolbe, Metzgers Eintreiber (The Den)

   Umsetzung 1, Prolog "Essies Schulden" (Phase 1, Tabelle "Akquise"):
     1. Schulden bezahlen            Barter 50: ein Viertel weniger
     2. Metzger ueberzeugen          Speech 60: 10 % Dauerabgabe statt Schulden
     3. Kolbe verpruegeln            Unarmed 60 oder STR 7: Schulden halbiert, Hitze +10
     4. Schuldschein stehlen         Steal 50 oder Sneak 60: Schulden weg, Metzger merkt es spaeter
     5. Essie ausliefern             Karma -25, Tyrannen-Route, Kolbe fuehrt das Haus

   Kolbe kommt als neue Figur statt eines Eingriffs in Metzgers Vanilla-Skript
   (Phase 2: minimal-invasiv). Nach dem Prolog verschwindet er, ausser Essie
   wurde ausgeliefert: Dann fuehrt er die Gosse fuer Metzger (rl_manager.h).

   Umsetzung 4, "Ketten" Akt 1 (Phase 3, Abschnitt 3.2): Kolbe bleibt nach dem
   Prolog, bis der Spieler Metzgers Angebot beantwortet hat. Annehmen fuehrt
   in den Tyrannen-Zweig (Riegel aussen, zwei aus den Pferchen), Ablehnen in
   den Fluchtzweig. Stirbt Kolbe vorher, ist die Gilde Feind.

   Umsetzung 5, "Ketten" Akt 2-5 im Tyrannen-Zweig: Kolbe bleibt als Metzgers
   Bote. Er findet Mara, wenn Essie fort ist, vergibt die Lieferungen nach
   Norden (Speech oder Barter), warnt vor Laras Leuten und bringt in Akt 5
   Metzgers Partnerschaft, oder den Verrat an ihm.

   Texte: text_src/english/dialog/rlkolbe.msg
*/

#define SCRIPT_REALNAME "rlkolbe"
#include "define.h"
#include "../headers/rotlicht.h"

#define NAME                    SCRIPT_RLKOLBE
#include "command.h"
#include "../headers/rl_prolog.h"

#define RL_KOLBE_SCHADEN        (15)    // Schaden, wenn der Faustkampf verloren geht

procedure start;
procedure talk_p_proc;
procedure map_enter_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;

procedure Node300;      // Prolog noch nicht begonnen
procedure Node301;      // die Verhandlung
procedure Node320;      // bezahlt
procedure Node321;      // Barter
procedure Node323;      // Speech
procedure Node325;      // Faustkampf
procedure Node327;      // Diebstahl
procedure Node329;      // Essie ausliefern: Rueckfrage
procedure Node330;      // Essie ausliefern: vollzogen
procedure Node340;      // nach dem Prolog
procedure Node350;      // Ketten, Akt 1: Metzgers Angebot
procedure Node351;      // "Und wenn ich nein sage?"
procedure Node352;      // angenommen
procedure Node353;      // abgelehnt
procedure Node354;      // zu wenig Geld
procedure Node700;      // Ketten, Akt 3 (Tyrann): Lieferungen nach Norden
procedure Node701;      // Lieferung Vault City
procedure Node702;      // Lieferung Vortis
procedure Node710;      // Akt 4: Laras Leute
procedure Node720;      // Akt 5: Metzgers Angebot
procedure Node721;      // Metzgers Mann
procedure Node723;      // Verrat
procedure Node730;      // Verrat angesagt
procedure Node740;      // Metzgers Mann
procedure Node750;      // der neue Metzger
procedure Node760;      // Mara gefunden (Essie ist fort)
procedure rl_haus_option;
procedure rl_angebot_optionen;
procedure Node999;

procedure rl_bezahlen;

variable haus;
variable welt;
variable h := RL_DEN;
variable angriff := 0;
variable ueberblende := 0;
variable selbst_weg := 0;   // destroy_p_proc: Kolbe geht nur, er stirbt nicht

#include "../headers/rl_manager.h"

procedure start begin
end

// Nach dem Prolog bleibt Kolbe nur, solange er gebraucht wird (rl_kolbe_bleibt)
procedure map_enter_p_proc begin
   welt := rl_lade_welt;
   if ((welt[RL_W_PROLOG] == RL_PROLOG_FERTIG) and not rl_kolbe_bleibt(welt)) then begin
      selbst_weg := 1;
      destroy_object(self_obj);
   end
end

// Stirbt Metzgers Eintreiber, bevor das Angebot beantwortet ist: Die Gilde ist Feind
procedure destroy_p_proc begin
   if (selbst_weg) then return;
   welt := rl_lade_welt;
   welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_TOT;
   if (welt[RL_W_KETTEN] == RL_KETTEN_ANGEBOT) then begin
      welt[RL_W_METZGER] := RL_METZGER_FEIND;
      call rl_ketten_akt1(welt, RL_KETTEN_ZWEIG_FLUCHT);
   end
end

procedure look_at_p_proc begin
   script_overrides;
   display_mstr(200);
end

procedure description_p_proc begin
   script_overrides;
   display_mstr(201);
end

procedure talk_p_proc begin
   haus := rl_lade_haeuser;
   welt := rl_lade_welt;
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (welt[RL_W_PROLOG] == RL_PROLOG_OFFEN) then
         call Node300;
      else if (welt[RL_W_PROLOG] == RL_PROLOG_LAEUFT) then
         call Node301;
      else if (welt[RL_W_KETTEN] == RL_KETTEN_ANGEBOT) then
         call Node350;
      else if ((welt[RL_W_MARA_WEG] == RL_MARA_KELLER) and (welt[RL_W_ESSIE] != RL_ESSIE_DA)
               and (welt[RL_W_MARA_GESEHEN] == 0)) then
         call Node760;
      else if (welt[RL_W_KETTEN_ZWEIG] == RL_KETTEN_ZWEIG_TYRANN) then begin
         if (welt[RL_W_KETTEN] == RL_KETTEN_KETTE) then
            call Node700;
         else if (welt[RL_W_KETTEN] == RL_KETTEN_TYLER) then
            call Node710;
         else if ((welt[RL_W_KETTEN] == RL_KETTEN_WAHL) and welt[RL_W_METZGER_VERRAT]) then
            call Node730;
         else if (welt[RL_W_KETTEN] == RL_KETTEN_WAHL) then
            call Node720;
         else if (welt[RL_W_KETTEN] == RL_KETTEN_METZGERS_MANN) then
            call Node740;
         else if (welt[RL_W_KETTEN] == RL_KETTEN_NEUER_METZGER) then
            call Node750;
         else if (welt[RL_W_ESSIE] != RL_ESSIE_DA) then
            call RLM_Start;
         else
            call Node340;
      end
      else if (welt[RL_W_ESSIE] != RL_ESSIE_DA) then
         call RLM_Start;
      else
         call Node340;
   gSay_End;
   end_dialogue;
   RLM_NACH_DIALOG

   // Essie wird abgefuehrt: kurz abblenden, ihr Skript entfernt sie
   if (ueberblende) then begin
      ueberblende := 0;
      gfade_out(600);
      gfade_in(600);
   end
   if (angriff) then begin
      angriff := 0;
      attack_setup(self_obj, dude_obj);
   end
end

procedure Node300 begin
   Reply(300);
   NOption(302, Node999, 004);
   NLowOption(302, Node999);
end

procedure Node301 begin
   variable schulden := rl_aktuelle_schulden(welt);
   variable versuche := welt[RL_W_KOLBE];
   variable steal := has_skill(dude_obj, SKILL_STEAL);
   variable sneak := has_skill(dude_obj, SKILL_SNEAK);

   Reply(mstr(301) + schulden + mstr(303));

   if (dude_caps >= schulden) then
      NOption(310, Node320, 004);
   if (((versuche bwand RL_KOLBE_BARTER) == 0) and (has_skill(dude_obj, SKILL_BARTER) >= 50)) then
      NOption(311, Node321, 004);
   if ((versuche bwand RL_KOLBE_SPEECH) == 0) then
      NOption(312, Node323, 004);
   if ((versuche bwand (RL_KOLBE_GEWONNEN bwor RL_KOLBE_VERLOREN)) == 0) then
      BOption(313, Node325, 004);
   if ((((steal >= 50) or (sneak >= 60))) and ((versuche bwand RL_KOLBE_DIEBSTAHL) == 0)) then
      NOption(314, Node327, 004);
   BOption(315, Node329, 004);
   NOption(316, Node999, 004);
   NLowOption(316, Node999);
end

// 1. Bezahlen (nach gewonnenem Faustkampf zaehlt es als "verpruegelt")
procedure Node320 begin
   call rl_bezahlen;
   Reply(320);
   NOption(341, Node999, 004);
end

procedure rl_bezahlen begin
   variable weg := RL_WEG_BEZAHLT;
   item_caps_adjust(dude_obj, -rl_aktuelle_schulden(welt));
   if (welt[RL_W_KOLBE] bwand RL_KOLBE_GEWONNEN) then weg := RL_WEG_VERPRUEGELT;
   call rl_prolog_abschliessen(haus, welt, weg);
end

// Barter 50: ein Viertel weniger (einmal)
procedure Node321 begin
   welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_BARTER bwor RL_KOLBE_RABATT;
   Reply(mstr(321) + rl_aktuelle_schulden(welt) + mstr(322));
   if (dude_caps >= rl_aktuelle_schulden(welt)) then
      NOption(310, Node320, 004);
   NOption(317, Node301, 004);
end

// Speech 60: Metzger nimmt 10 % Dauerabgabe statt der Schulden (ein Versuch)
procedure Node323 begin
   welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_SPEECH;
   if (has_skill(dude_obj, SKILL_SPEECH) >= 60) then begin
      call rl_prolog_abschliessen(haus, welt, RL_WEG_PARTNER);
      Reply(323);
      NOption(341, Node999, 004);
   end else begin
      Reply(324);
      NOption(317, Node301, 004);
   end
end

// Faustkampf, nicht toedlich: Unarmed 60 oder STR 7 (ein Versuch)
procedure Node325 begin
   if ((has_skill(dude_obj, SKILL_UNARMED_COMBAT) >= 60) or (dude_strength >= 7)) then begin
      welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_GEWONNEN;
      welt[RL_W_SCHULDEN] := welt[RL_W_SCHULDEN] / 2;
      Reply(325);
   end else begin
      welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_VERLOREN;
      critter_dmg(dude_obj, RL_KOLBE_SCHADEN, DMG_normal_dam);
      Reply(326);
   end
   NOption(317, Node301, 004);
end

// Steal 50 oder Sneak 60; Erfolg mit der Chance des besseren Werts
procedure Node327 begin
   variable wert := rl_max(has_skill(dude_obj, SKILL_STEAL), has_skill(dude_obj, SKILL_SNEAK));
   welt[RL_W_KOLBE] := welt[RL_W_KOLBE] bwor RL_KOLBE_DIEBSTAHL;
   if (random(1, 100) <= wert) then begin
      call rl_prolog_abschliessen(haus, welt, RL_WEG_GESTOHLEN);
      Reply(327);
      NOption(341, Node999, 004);
   end else begin
      welt[RL_W_METZGER] := RL_METZGER_FEIND;       // erwischt: die Gilde ist Feind
      angriff := 1;
      Reply(328);
      NOption(342, Node999, 004);
   end
end

procedure Node329 begin
   Reply(332);
   BOption(330, Node330, 004);
   NOption(331, Node301, 004);
end

// 5. Essie ausliefern: Tyrannen-Route
procedure Node330 begin
   call rl_prolog_abschliessen(haus, welt, RL_WEG_AUSGELIEFERT);
   ueberblende := 1;
   Reply(329);
   NOption(341, Node999, 004);
end

procedure Node340 begin
   Reply(340);
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

/* ------------------------------------------------------------------ */
/* Ketten, Akt 1: Das Angebot (Phase 3, Abschnitt 3.2)                 */
/* ------------------------------------------------------------------ */
procedure Node350 begin
   // Anpassung an Vanilla: Ohne Metzger gibt es kein Angebot, die Linie geht im Fluchtzweig weiter
   if (rl_metzger_tot) then begin
      call rl_ketten_akt1(welt, RL_KETTEN_ZWEIG_FLUCHT);
      Reply(360);
      NOption(341, Node999, 004);
      NLowOption(341, Node999);
      return;
   end
   // Wer Metzger bestohlen hat, bekommt nichts angeboten
   if (welt[RL_W_METZGER] == RL_METZGER_FEIND) then begin
      call rl_ketten_akt1(welt, RL_KETTEN_ZWEIG_FLUCHT);
      Reply(361);
      NOption(342, Node999, 004);
      NLowOption(342, Node999);
      return;
   end
   if (haus[rl_idx(RL_DEN, RL_F_GEKAUFT)] bwand rl_bit(RL_M_DEN_RIEGEL_INNEN)) then
      Reply(mstr(350) + " " + mstr(351));
   else
      Reply(350);
   call rl_angebot_optionen;
end

procedure Node351 begin
   Reply(357);
   call rl_angebot_optionen;
end

procedure rl_angebot_optionen begin
   if (rlm_bezahlbar(RL_ANGEBOT_WARE + RL_RIEGEL_AUSSEN_KOSTEN)) then begin
      BOption(352, Node352, 004);
      NLowOption(355, Node352);
   end else begin
      NOption(363, Node354, 004);
   end
   NOption(353, Node351, 004);
   GOption(354, Node353, 004);
   NLowOption(356, Node353);
end

// Annehmen: Tyrannen-Zweig. Der Keller wird zum Pferch, zwei kommen aus den Pferchen.
procedure Node352 begin
   call rlm_bezahlen(RL_ANGEBOT_WARE + RL_RIEGEL_AUSSEN_KOSTEN);
   call rl_riegel_aussen(haus, RL_DEN);
   call rl_zwang_dazu(haus, RL_DEN, RL_ANGEBOT_PERSONEN);
   call rl_ketten_akt1(welt, RL_KETTEN_ZWEIG_TYRANN);
   welt[RL_W_METZGER] := RL_METZGER_FREUND;
   // Essie fuehrt das Haus weiter, aber nicht mehr mit ganzem Herzen
   if (welt[RL_W_ESSIE] == RL_ESSIE_DA) then
      haus[rl_idx(RL_DEN, RL_F_FUEHRUNG)] := rl_max(0, haus[rl_idx(RL_DEN, RL_F_FUEHRUNG)] - 10);
   Reply(358);
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

// Ablehnen: Fluchtzweig. Metzger merkt es sich.
procedure Node353 begin
   call rl_ketten_akt1(welt, RL_KETTEN_ZWEIG_FLUCHT);
   welt[RL_W_METZGER_NEIN] := 1;
   if (welt[RL_W_ESSIE] != RL_ESSIE_DA) then
      Reply(362);
   else
      Reply(359);
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

// Das Angebot steht, bis der Spieler zahlen kann oder ablehnt
procedure Node354 begin
   Reply(364);
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

/* ------------------------------------------------------------------ */
/* Ketten, Akt 2-5 im Tyrannen-Zweig (Umsetzung 5)                     */
/* ------------------------------------------------------------------ */

// Fuehrt Kolbe das Haus, kommt man von hier ins Manager-Menue
procedure rl_haus_option begin
   if (welt[RL_W_ESSIE] != RL_ESSIE_DA) then
      NOption(706, RLM_Start, 004);
end

procedure Node700 begin
   if (welt[RL_W_AUFTRAG] != RL_AUFTRAG_KEINER) then begin
      Reply(705);
   end else begin
      Reply(700);
      BOption(mstr(701) + rl_liefer_chance + mstr(703), Node701, 004);
      BOption(mstr(702) + rl_liefer_chance + mstr(703), Node702, 004);
   end
   call rl_haus_option;
   NOption(704, Node999, 004);
   NLowOption(704, Node999);
end

procedure Node701 begin
   call rl_auftrag_starten(welt, RL_AUFTRAG_VC, rl_liefer_chance);
   Reply(707);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node702 begin
   call rl_auftrag_starten(welt, RL_AUFTRAG_VORTIS, rl_liefer_chance);
   Reply(707);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node710 begin
   Reply(710);
   call rl_haus_option;
   NOption(711, Node999, 004);
   NLowOption(711, Node999);
end

procedure Node720 begin
   Reply(720);
   BOption(721, Node721, 004);
   BOption(723, Node723, 004);
   call rl_haus_option;
   NOption(725, Node999, 004);
   NLowOption(725, Node999);
end

procedure Node721 begin
   call rl_ketten_ende(haus, welt, RL_KETTEN_METZGERS_MANN);
   Reply(722);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node723 begin
   welt[RL_W_METZGER_VERRAT] := 1;
   Reply(724);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node730 begin
   Reply(730);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node740 begin
   Reply(740);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node750 begin
   Reply(750);
   call rl_haus_option;
   NOption(341, Node999, 004);
   NLowOption(341, Node999);
end

procedure Node760 begin
   welt[RL_W_MARA_GESEHEN] := 1;
   Reply(760);
   call rl_haus_option;
   NOption(761, Node999, 004);
   NLowOption(761, Node999);
end

procedure Node999 begin
end
