/*
   rlroz.ssl - Roz Mercer, Madame des Silbernen Strumpfbands (New Reno)

   Umsetzung 7: Roz kommt mit der Uebernahme (Pagano schickt sie). Sie hat
   zehn Jahre im Shark Club Karten gegeben und weiss, wer betruegt.
   Fuehrung 55. Das gemeinsame Manager-Menue (rl_manager.h). Ist der
   Consigliere tot, zahlt sie auch die HQ-Kasse aus.

   Texte: text_src/english/dialog/rlroz.msg (ihre Saetze) und
   _rl_manager.inc (die neutralen Texte des Manager-Menues)
*/

#define SCRIPT_REALNAME "rlroz"
#define NAME                    SCRIPT_RLROZ
#include "define.h"
#include "../headers/rotlicht.h"
#include "command.h"

procedure start;
procedure talk_p_proc;
procedure map_enter_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure Node800;      // erste Begegnung
procedure Node810;      // HQ-Kasse, wenn Asch tot ist
procedure Node820;      // Virgin Street, Akt 3: der Dealer
procedure Node821;      // gefunden
procedure Node822;      // rauswerfen
procedure Node823;      // umdrehen
procedure Node824;      // verschwinden lassen
procedure Node825;      // heilen
procedure rl_dealer_weg(variable text);
procedure Node999;

variable haus;
variable welt;
variable h := RL_NEW_RENO;
variable selbst_weg := 0;

#define RLM_EXTRA_OPTIONEN   if ((welt[RL_W_NR_TOTE] bwand RL_NR_TOT_ASCH) and (welt[RL_W_HQ_KASSE] > 0)) then \
                                NOption(810, Node810, 004);                                                     \
                             if ((welt[RL_W_VIRGIN] == RL_VIRGIN_JET) or ((welt[RL_W_VIRGIN] == RL_VIRGIN_MESSER) \
                                 and ((welt[RL_W_VIRGIN_FLAGS] bwand RL_VF_GEHEILT) == 0))) then                \
                                NOption(819, Node820, 004);

#include "../headers/rl_manager.h"

procedure start begin
end

procedure map_enter_p_proc begin
   haus := rl_lade_haeuser;
   if (not rl_nr_besitz(haus)) then begin
      selbst_weg := 1;
      destroy_object(self_obj);
   end
end

// Ohne Madame fuehrt das Haus sich selbst, schlecht
procedure destroy_p_proc begin
   if (selbst_weg) then return;
   welt := rl_lade_welt;
   haus := rl_lade_haeuser;
   welt[RL_W_NR_TOTE] := welt[RL_W_NR_TOTE] bwor RL_NR_TOT_ROZ;
   haus[rl_idx(RL_NEW_RENO, RL_F_FUEHRUNG)] := RL_OHNE_ROZ_FUEHRUNG;
end

procedure look_at_p_proc begin
   script_overrides;
   display_mstr(200);
end

procedure description_p_proc begin
   script_overrides;
   display_mstr(201);
end

procedure talk_p_proc begin
   haus := rl_lade_haeuser;
   welt := rl_lade_welt;
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if ((welt[RL_W_NR_KENNT] bwand RL_NR_KENNT_ROZ) == 0) then
         call Node800;
      else
         call RLM_Start;
   gSay_End;
   end_dialogue;
   RLM_NACH_DIALOG
end

procedure Node800 begin
   welt[RL_W_NR_KENNT] := welt[RL_W_NR_KENNT] bwor RL_NR_KENNT_ROZ;
   Reply(800);
   NOption(801, RLM_Start, 004);
   NOption(115, RLM_Ende, 004);
   NLowOption(116, RLM_Kasse);
end

procedure Node810 begin
   variable betrag := welt[RL_W_HQ_KASSE];
   item_caps_adjust(dude_obj, betrag);
   welt[RL_W_HQ_KASSE] := 0;
   Reply(mstr(811) + betrag + mstr(812));
   NOption(123, RLM_Start, 004);
   NOption(124, RLM_Ende, 004);
end

/* ------------------------------------------------------------------ */
/* Blut auf der Virgin Street, Akt 3: Jet im Blut (Phase 3, 3.1)        */
/* ------------------------------------------------------------------ */
procedure Node820 begin
   variable f := welt[RL_W_VIRGIN_FLAGS];
   if (f bwand RL_VF_DEALER_WEG) then
      Reply(826);
   else if (f bwand RL_VF_DEALER_GEFUNDEN) then begin
      call Node821;
      return;
   end else begin
      Reply(820);
      if (dude_perception >= 7) then NOption(830, Node821, 004);
      if (has_skill(dude_obj, SKILL_SNEAK) >= 60) then NOption(831, Node821, 004);
      if (haus[rl_idx(h, RL_F_MORAL)] >= 70) then GOption(832, Node821, 004);
   end
   if (((f bwand RL_VF_GEHEILT) == 0) and ((has_skill(dude_obj, SKILL_DOCTOR) >= 60)
       or obj_is_carrying_obj_pid(dude_obj, PID_JET_ANTIDOTE))) then
      GOption(833, Node825, 004);
   NOption(123, RLM_Start, 004);
end

procedure Node821 begin
   welt[RL_W_VIRGIN_FLAGS] := welt[RL_W_VIRGIN_FLAGS] bwor RL_VF_DEALER_GEFUNDEN;
   Reply(821);
   if ((has_skill(dude_obj, SKILL_UNARMED_COMBAT) >= 60) or global_var(GVAR_NEW_RENO_HAS_REP_PRIZEFIGHTER)) then
      NOption(834, Node822, 004);
   if (has_skill(dude_obj, SKILL_SPEECH) >= 70) then GOption(835, Node823, 004);
   BOption(836, Node824, 004);
   NOption(123, RLM_Start, 004);
end

procedure rl_dealer_weg(variable text) begin
   welt[RL_W_VIRGIN_FLAGS] := welt[RL_W_VIRGIN_FLAGS] bwor RL_VF_DEALER_WEG;
   Reply(text);
   NOption(123, Node820, 004);
end

procedure Node822 begin
   call rl_dealer_weg(mstr(822));
end

procedure Node823 begin
   welt[RL_W_VIRGIN_FLAGS] := welt[RL_W_VIRGIN_FLAGS] bwor RL_VF_BEWEISE;
   call rl_dealer_weg(mstr(823));
end

procedure Node824 begin
   call rl_haus_plus(haus, h, RL_F_HITZE, 20);
   call rl_dealer_weg(mstr(824));
end

procedure Node825 begin
   welt[RL_W_VIRGIN_FLAGS] := welt[RL_W_VIRGIN_FLAGS] bwor RL_VF_GEHEILT;
   call rl_haus_plus(haus, h, RL_F_MORAL, 10);
   Reply(825);
   NOption(123, RLM_Start, 004);
end

procedure Node999 begin
end
